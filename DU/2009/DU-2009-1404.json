   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_2/ust_1",
     "text": "Siedzibami izb celnych i urzędów celnych, wymienionych w § 1, są miejscowości wskazane w ich nazwach, z zastrzeżeniem ust. 2.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_2/ust_2",
     "text": "Siedzibą Urzędu Celnego, o którym mowa w § 1 pkt 12 lit. a, jest Olszyna.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem 31 października 2009 r.[^2]",
