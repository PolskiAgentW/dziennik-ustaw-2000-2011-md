 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ROLNICTWA I ROZWOJU WSI[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 30 listopada 2009 r."
  },
  {
   "type": "text",
   "text": "w sprawie maksymalnych sum ubezpieczenia dla poszczególnych upraw rolnych i zwierząt gospodarskich na 2010 r."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 5 ust. 2e ustawy z dnia 7 lipca 2005 r. o ubezpieczeniach upraw rolnych i zwierząt gospodarskich (Dz. U. Nr 150, poz. 1249, z późn. zm.[^2]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "W 2010 r. maksymalne sumy ubezpieczenia:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "1 ha upraw rolnych wynoszą:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_1/lit_a",
       "text": "6 000 zł — dla zbóż,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_1/lit_b",
       "text": "13 000 zł — dla kukurydzy,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_1/lit_c",
       "text": "6 000 zł — dla rzepaku i rzepiku,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_1/pkt_1/lit_d",
       "text": "40 000 zł — dla chmielu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_1/pkt_1/lit_e",
       "text": "35 000 zł — dla tytoniu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_1/pkt_1/lit_f",
       "text": "129 000 zł — dla warzyw gruntowych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_1/pkt_1/lit_g",
       "text": "61 000 zł — dla drzew i krzewów owocowych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_1/pkt_1/lit_h",
       "text": "50 000 zł — dla truskawek,",
       "children": []
      },
      {
       "type": "lit",
       "num": "i",
       "path": "par_1/pkt_1/lit_i",
       "text": "25 000 zł — dla ziemniaków,",
       "children": []
      },
      {
       "type": "lit",
       "num": "j",
       "path": "par_1/pkt_1/lit_j",
       "text": "9 000 zł — dla buraków cukrowych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "k",
       "path": "par_1/pkt_1/lit_k",
       "text": "15 000 zł — dla roślin strączkowych;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "1 sztuki zwierzęcia wynoszą:",
     "children": [
