       "text": "53 zł — dla kur, perlic i przepiórek,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_1/pkt_2/lit_g",
       "text": "65 zł — dla kaczek,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_1/pkt_2/lit_h",
       "text": "250 zł — dla gęsi,",
       "children": []
      },
      {
       "type": "lit",
       "num": "i",
       "path": "par_1/pkt_2/lit_i",
       "text": "130 zł — dla indyków,",
       "children": []
      },
      {
       "type": "lit",
       "num": "j",
       "path": "par_1/pkt_2/lit_j",
       "text": "750 zł — dla strusi.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
