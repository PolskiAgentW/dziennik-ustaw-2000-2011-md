      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_2/lit_b",
       "text": "13 000 zł — dla koni,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_2/lit_c",
       "text": "700 zł — dla owiec,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_1/pkt_2/lit_d",
       "text": "800 zł — dla kóz,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_1/pkt_2/lit_e",
       "text": "1 500 zł — dla świń,",
       "children": []
      },
      {
