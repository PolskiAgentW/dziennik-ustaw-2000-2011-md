        },
        {
         "type": "lit",
         "num": "f",
         "path": "par_8/pkt_2/lit_f",
         "text": "grudziądzkiego — Grudziądz, f) strzelecko-drezdeneckiego — Strzelce Krajeńg) inowrocławskiego — Inowrocław, skie,",
         "children": []
        },
        {
         "type": "lit",
         "num": "h",
         "path": "par_8/pkt_2/lit_h",
         "text": "lipnowskiego — Skępe, g) sulęcińskiego — Sulęcin,",
         "children": []
        },
        {
         "type": "lit",
         "num": "i",
         "path": "par_8/pkt_2/lit_i",
         "text": "mogileńskiego — Mogilno, h) świebodzińskiego — Świebodzin,",
