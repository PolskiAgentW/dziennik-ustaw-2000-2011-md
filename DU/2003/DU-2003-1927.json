         "children": []
        },
        {
         "type": "lit",
         "num": "n",
         "path": "par_8/pkt_1/lit_n",
         "text": "oleśnickiego — Syców, g) kraśnickiego — Kraśnik,",
         "children": []
        },
        {
         "type": "lit",
         "num": "o",
         "path": "par_8/pkt_1/lit_o",
         "text": "oławskiego — Oława, h) lubartowskiego — Lubartów,",
         "children": []
        },
        {
         "type": "lit",
         "num": "p",
         "path": "par_8/pkt_1/lit_p",
