         "type": "lit",
         "num": "b",
         "path": "par_8/pkt_2/lit_b",
         "text": "brodnickiego — Brodnica, b) krośnieńskiego — Krosno Odrzańskie,",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_8/pkt_2/lit_c",
         "text": "bydgoskiego — Bydgoszcz, c) międzyrzeckiego — Międzyrzecz,",
