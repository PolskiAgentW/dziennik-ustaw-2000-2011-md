         "children": []
        },
        {
         "type": "lit",
         "num": "r",
         "path": "par_8/pkt_1/lit_r",
         "text": "strzelińskiego — Strzelin, j) łęczyńskiego — Łęczna,",
         "children": []
        },
        {
         "type": "lit",
         "num": "s",
         "path": "par_8/pkt_1/lit_s",
         "text": "średzkiego — Środa Śląska, k) łukowskiego — Łuków,",
         "children": []
        },
        {
         "type": "lit",
         "num": "t",
         "path": "par_8/pkt_1/lit_t",
         "text": "świdnickiego — Świdnica, l) opolskiego — Opole Lubelskie,",
         "children": []
        },
        {
         "type": "lit",
         "num": "u",
         "path": "par_8/pkt_1/lit_u",
         "text": "trzebnickiego — Trzebnica, m) parczewskiego — Parczew,",
         "children": []
        },
        {
         "type": "lit",
         "num": "w",
         "path": "par_8/pkt_1/lit_w",
         "text": "wałbrzyskiego — Wałbrzych, n) puławskiego — Puławy,",
         "children": []
        },
        {
         "type": "lit",
         "num": "y",
         "path": "par_8/pkt_1/lit_y",
         "text": "wołowskiego — Wołów, o) radzyńskiego — Radzyń Podlaski,",
         "children": []
        },
        {
         "type": "lit",
         "num": "z",
         "path": "par_8/pkt_1/lit_z",
         "text": "wrocławskiego — Wrocław, p) ryckiego — Ryki,",
         "children": []
        },
        {
         "type": "lit",
         "num": "za",
         "path": "par_8/pkt_1/lit_za",
         "text": "ząbkowickiego — Ząbkowice Śląskie, r) świdnickiego — Piaski,",
         "children": []
        },
        {
         "type": "lit",
         "num": "zb",
         "path": "par_8/pkt_1/lit_zb",
         "text": "zgorzeleckiego — Zgorzelec, s) tomaszowskiego — Tomaszów Lubelski,",
         "children": []
        },
        {
         "type": "lit",
         "num": "zc",
         "path": "par_8/pkt_1/lit_zc",
         "text": "złotoryjskiego — Pielgrzymka; t) włodawskiego — Włodawa,",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_8/pkt_2",
       "text": "w województwie kujawsko-pomorskim dla powia- u) zamojskiego — Zamość; tów: 4) w województwie lubuskim dla powiatów: a) aleksandrowskiego — Aleksandrów Kujawski, a) gorzowskiego — Gorzów Wielkopolski,",
       "children": [
