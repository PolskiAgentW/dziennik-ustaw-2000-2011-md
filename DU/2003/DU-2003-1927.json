         "children": []
        },
        {
         "type": "lit",
         "num": "l",
         "path": "par_8/pkt_1/lit_l",
         "text": "lwóweckiego — Gryfów Śląski, e) janowskiego — Janów Lubelski,",
         "children": []
        },
        {
         "type": "lit",
         "num": "m",
         "path": "par_8/pkt_1/lit_m",
