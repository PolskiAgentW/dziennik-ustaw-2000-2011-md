{
 "eli": "DU/2003/5",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 7 stycznia 2003 r. w sprawie szczegółowego zakresu działania Ministra Gospodarki, Pracy i Polityki Społecznej",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2003/5/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 7 stycznia 2003 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowego zakresu działania Ministra Gospodarki, Pracy i Polityki Społecznej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 33 ust. 1 i 1a ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 1999 r. Nr 82, poz. 929, z 2000 r. Nr 120, poz. 1268 oraz z 2001 r. Nr 102, poz. 1116 i Nr 154, poz. 1799 i 1800) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Rozporządzenie określa szczegółowy zakres działania Ministra Gospodarki, Pracy i Polityki Społecznej, zwanego dalej „Ministrem”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Minister kieruje następującymi działami administracji rządowej:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_2/pkt_1",
       "text": "gospodarka;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_2/pkt_2",
       "text": "praca;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_2/pkt_3",
       "text": "rozwój regionalny;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/ust_2/pkt_4",
       "text": "turystyka;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_1/ust_2/pkt_5",
       "text": "zabezpieczenie społeczne.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_1/ust_3",
     "text": "Minister jest dysponentem części 20, 31, 34, 40 i 44 budżetu państwa.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_1/ust_4",
     "text": "Obsługę Ministra zapewnia Ministerstwo Gospodarki, Pracy i Polityki Społecznej.",
     "children": []
    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_1/ust_5",
     "text": "Organami podległymi Ministrowi lub przez niego nadzorowanymi są:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_5/pkt_1",
       "text": "Prezes Głównego Urzędu Miar;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_5/pkt_2",
       "text": "Prezes Urzędu Regulacji Energetyki;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_5/pkt_3",
       "text": "Urząd Patentowy Rzeczypospolitej Polskiej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/ust_5/pkt_4",
       "text": "Urząd do Spraw Kombatantów i Osób Represjonowanych.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Minister wykonuje zadania w zakresie reformy zabezpieczenia społecznego.",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
