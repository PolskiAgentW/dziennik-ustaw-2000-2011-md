{
 "eli": "DU/2003/1168",
 "title": "Rozporządzenie Ministra Zdrowia z dnia 16 czerwca 2003 r. w sprawie określenia kategorii produktów będących kosmetykami",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2003/1168/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ZDROWIA[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 16 czerwca 2003 r."
  },
  {
   "type": "text",
   "text": "w sprawie określenia kategorii produktów będących kosmetykami"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 2 ust. 2 ustawy z dnia 30 marca 2001 r. o kosmetykach (Dz. U. Nr 42, poz. 473 oraz z 2003 r. Nr 73, poz. 659) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rozporządzenie określa kategorie produktów będących kosmetykami w rozumieniu art. 2 ust. 1 ustawy z dnia 30 marca 2001 r. o kosmetykach.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Najczęściej występującymi kategoriami kosmetyków są:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "kremy, emulsje, płyny, żele i oliwki oraz balsamy do skóry;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "maseczki do twarzy, z wyjątkiem maseczek służących do peelingu chemicznego;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "podkłady barwiące;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "pudry do makijażu, pudry po kąpieli, pudry higieniczne;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "mydła toaletowe, mydła dezodoryzujące;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_2/pkt_6",
     "text": "perfumy, wody toaletowe i kolońskie;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_2/pkt_7",
     "text": "środki do kąpieli i pod prysznic;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_2/pkt_8",
     "text": "środki do depilacji;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_2/pkt_9",
     "text": "dezodoranty i środki przeciw poceniu;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_2/pkt_10",
     "text": "środki do pielęgnacji włosów, w tym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_10/lit_a",
       "text": "środki do barwienia i rozjaśniania,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_10/lit_b",
       "text": "do trwałej ondulacji, do prostowania i utrwalania,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_10/lit_c",
       "text": "do układania,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_10/lit_d",
       "text": "do mycia,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_10/lit_e",
       "text": "odżywki,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_2/pkt_10/lit_f",
       "text": "do utrwalania fryzury;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "11",
     "path": "par_2/pkt_11",
     "text": "środki do golenia;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "12",
     "path": "par_2/pkt_12",
     "text": "środki do makijażu i demakijażu;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "13",
     "path": "par_2/pkt_13",
     "text": "środki przeznaczone do pielęgnacji i malowania ust;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "14",
     "path": "par_2/pkt_14",
     "text": "środki do pielęgnacji zębów i jamy ustnej;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "15",
     "path": "par_2/pkt_15",
     "text": "środki do pielęgnacji i malowania paznokci;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "16",
     "path": "par_2/pkt_16",
     "text": "środki do higieny zewnętrznych narządów płciowych;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "17",
     "path": "par_2/pkt_17",
     "text": "środki do opalania i chroniące przed promieniowaniem ultrafioletowym;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "18",
     "path": "par_2/pkt_18",
     "text": "środki do samoopalania;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "19",
     "path": "par_2/pkt_19",
     "text": "środki do rozjaśniania skóry;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "20",
     "path": "par_2/pkt_20",
     "text": "środki przeciw zmarszczkom.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Zdrowia: L. Sikorski"
  }
 ],
 "annexes": [],
 "footnotes": {
  "1": "Minister Zdrowia kieruje działem administracji rządowej — zdrowie, na podstawie § 1 ust. 2 rozporządzenia Prezesa Rady Ministrów z dnia 28 czerwca 2002 r. w sprawie szczegółowego zakresu działania Ministra Zdrowia (Dz. U. Nr 93, poz. 833)."
 }
}
