     "text": "Nazwa i adres oddziału/jednostki organizacyjnej banku udzielającej kredytu ................................................ ...............................................................................................................................................................................",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_2/ust_3",
     "text": "Nr telefonu i innych środków komunikowania się ............................................................................................",
     "children": [
      {
       "type": "text",
       "text": "II. Dane dotyczące krajowego dostawcy:"
      }
     ]
    },
    {
     "type": "ust",
