{
 "eli": "DU/2003/52",
 "title": "Rozporządzenie Ministra Gospodarki z dnia 6 stycznia 2003 r. w sprawie wykazów hut podlegających restrukturyzacji",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2003/52/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA GOSPODARKI[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 6 stycznia 2003 r."
  },
  {
   "type": "text",
   "text": "w sprawie wykazów hut podlegających restrukturyzacji"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 2 ustawy z dnia 24 sierpnia 2001 r. o restrukturyzacji hutnictwa żelaza i stali (Dz. U. Nr 111, poz. 1196) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ustala się wykaz hut:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "podlegających restrukturyzacji hutnictwa żelaza i stali, stanowiący załącznik nr 1 do rozporządzenia;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "do których stosuje się przepisy rozdziału 3 ustawy z dnia 24 sierpnia 2001 r. o restrukturyzacji hutnictwa żelaza i stali, stanowiący załącznik nr 2 do rozporządzenia.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc rozporządzenie Ministra Gospodarki z dnia 19 listopada 2001 r. w sprawie wykazów hut podlegających restrukturyzacji (Dz. U. Nr 138, poz. 1552).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Gospodarki: J. Piechota"
  }
 ],
