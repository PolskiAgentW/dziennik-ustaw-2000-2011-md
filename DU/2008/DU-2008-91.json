 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ŚRODOWISKA[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 17 stycznia 2008 r."
  },
  {
   "type": "text",
   "text": "w sprawie wzoru wniosku o wydanie zezwolenia wstępnego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 19 ustawy z dnia 29 czerwca 2007 r. o międzynarodowym przemieszczaniu odpadów (Dz. U. Nr 124, poz. 859) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Określa się wzór wniosku o wydanie zezwolenia wstępnego, stanowiący załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Środowiska: M. Nowicki"
  }
 ],
