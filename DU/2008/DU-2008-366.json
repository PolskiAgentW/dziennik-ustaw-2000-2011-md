        },
        {
         "type": "lit",
         "num": "j",
         "path": "par_6/ust_1/pkt_1/lit_j",
         "text": "sposób rejestracji obrazów,",
         "children": []
        },
        {
         "type": "lit",
         "num": "k",
         "path": "par_6/ust_1/pkt_1/lit_k",
         "text": "wykaz fantomów,",
         "children": []
        },
        {
         "type": "lit",
         "num": "l",
         "path": "par_6/ust_1/pkt_1/lit_l",
         "text": "wykaz źródeł kontrolnych;",
         "children": []
        }
       ]
      },
