         ]
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_6/ust_2/pkt_2",
       "text": "nie jest wyposażony w:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_6/ust_2/pkt_2/lit_a",
         "text": "cyklotron, informacje dotyczące tego urządzenia obejmują nazwy i adresy dostawców izotopów,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_6/ust_2/pkt_2/lit_b",
         "text": "syntetyzer produktów radiofarmaceutycznych, informacje dotyczące tego urządzenia obejmują nazwy i adresy dostawców produktów radiofarmaceutycznych.",
         "children": []
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "7",
   "path": "par_7",
   "text": "",
   "children": [
