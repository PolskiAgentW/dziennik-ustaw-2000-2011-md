           "type": "text",
           "text": "— nazwę wytwórcy i instalatora,"
          },
          {
           "type": "text",
           "text": "— rok produkcji,"
          },
          {
           "type": "text",
           "text": "— kod identyfikacyjny,"
          },
          {
           "type": "text",
           "text": "— rodzaje i aktywności wytwarzanych produktów radiofarmaceutycznych;"
