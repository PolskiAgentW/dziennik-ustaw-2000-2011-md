       "path": "par_6/ust_1/pkt_1",
       "text": "kamery scyntylacyjnej obejmują:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_6/ust_1/pkt_1/lit_a",
         "text": "rodzaj kamery zgodnie z listą kodów zawartych w załączniku do rozporządzenia,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_6/ust_1/pkt_1/lit_b",
         "text": "model lub typ,",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_6/ust_1/pkt_1/lit_c",
         "text": "kod identyfikacyjny,",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_6/ust_1/pkt_1/lit_d",
         "text": "nazwę wytwórcy i instalatora,",
         "children": []
        },
        {
         "type": "lit",
         "num": "e",
         "path": "par_6/ust_1/pkt_1/lit_e",
         "text": "rok produkcji,",
         "children": []
        },
        {
         "type": "lit",
         "num": "f",
         "path": "par_6/ust_1/pkt_1/lit_f",
         "text": "rok uruchomienia,",
         "children": []
        },
        {
         "type": "lit",
         "num": "g",
         "path": "par_6/ust_1/pkt_1/lit_g",
         "text": "rodzaje kolimatorów zgodnie z listą kodów zawartych w załączniku do rozporządzenia,",
         "children": []
        },
        {
         "type": "lit",
         "num": "h",
         "path": "par_6/ust_1/pkt_1/lit_h",
         "text": "nazwę, wersję i producenta stosowanego oprogramowania,",
         "children": []
        },
        {
         "type": "lit",
         "num": "i",
         "path": "par_6/ust_1/pkt_1/lit_i",
         "text": "liczbę stacji przetwarzania danych,",
