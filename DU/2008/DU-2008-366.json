       "path": "par_6/ust_1/pkt_2",
       "text": "emisyjnego tomografu pozytonowego (PET) obejmują:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_6/ust_1/pkt_2/lit_a",
         "text": "rodzaj PET zgodnie z listą kodów zawartych w załączniku do rozporządzenia,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_6/ust_1/pkt_2/lit_b",
         "text": "nazwę wytwórcy i instalatora,",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_6/ust_1/pkt_2/lit_c",
         "text": "model lub typ,",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_6/ust_1/pkt_2/lit_d",
         "text": "kod identyfikacyjny,",
         "children": []
        },
        {
         "type": "lit",
         "num": "e",
         "path": "par_6/ust_1/pkt_2/lit_e",
         "text": "rodzaj detektorów zgodnie z listą kodów zawartych w załączniku do rozporządzenia,",
         "children": []
        },
        {
         "type": "lit",
         "num": "f",
         "path": "par_6/ust_1/pkt_2/lit_f",
         "text": "rok produkcji,",
