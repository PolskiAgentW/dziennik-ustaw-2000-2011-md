        {
         "type": "lit",
         "num": "c",
         "path": "ust_3/pkt_3/lit_c",
         "text": "geofizyka (Uniwersytet Śląski w Katowicach, Akademia Górniczo-Hutnicza w Krakowie),",
         "children": []
