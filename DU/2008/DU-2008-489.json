        },
        {
         "type": "lit",
         "num": "c",
         "path": "ust_3/pkt_4/lit_c",
         "text": "zaawansowane materiały i nanotechnologia (Uniwersytet Jagielloński w Krakowie).",
         "children": []
        }
       ]
      }
     ]
    }
   ]
