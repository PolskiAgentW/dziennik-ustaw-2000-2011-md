  {
   "heading": "Załącznik nr 2",
   "body": [
    {
     "type": "text",
     "text": "WYKAZ WSKAŹNIKÓW KOSZTOCHŁONNOŚCI MAKROKIERUNKÓW I STUDIÓW MIĘDZYKIERUNKOWYCH ORAZ KIERUNKÓW INNYCH NIŻ OKREŚLONE W § 2 ROZPORZĄDZENIA"
    },
    {
     "type": "ust",
     "num": "1",
     "path": "ust_1",
     "text": "Dla poszczególnych makrokierunków studiów określa się następujące wskaźniki kosztochłonności:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "ust_1/pkt_1",
       "text": "k s1 = 1,0 dla:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "ust_1/pkt_1/lit_a",
         "text": "makrokierunku (ekonomia, finanse i rachunkowość),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "ust_1/pkt_1/lit_b",
         "text": "makrokierunku (filozofia, historia),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "ust_1/pkt_1/lit_c",
         "text": "makrokierunku (stosunki międzynarodowe, ekonomia);",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "ust_1/pkt_2",
       "text": "k s2 = 1,5 dla:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "ust_1/pkt_2/lit_a",
         "text": "makrokierunku (zarządzanie, finanse i rachunkowość),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "ust_1/pkt_2/lit_b",
         "text": "makrokierunku (zarządzanie, stosunki międzynarodowe);",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "ust_1/pkt_3",
       "text": "k = 2,0 dla makrokierunku filologiczno-kulturoznawczego; s3",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "ust_1/pkt_4",
       "text": "k s4 = 2,5 dla:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "ust_1/pkt_4/lit_a",
         "text": "makrokierunku (automatyka i robotyka, zarządzanie),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "ust_1/pkt_4/lit_b",
         "text": "makrokierunku (biologia, geografia),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "ust_1/pkt_4/lit_c",
         "text": "makrokierunku (biologia, geologia),",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "ust_1/pkt_4/lit_d",
         "text": "makrokierunku (inżynieria i ochrona środowiska);",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "ust_1/pkt_5",
       "text": "k s5 = 3,0 dla:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "ust_1/pkt_5/lit_a",
         "text": "makrokierunku (akwakultura i bezpieczeństwo żywności),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "ust_1/pkt_5/lit_b",
         "text": "makrokierunku (automatyka i robotyka, elektronika i telekomunikacja, informatyka),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "ust_1/pkt_5/lit_c",
         "text": "makrokierunku (bioinżynieria produkcji żywności),",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "ust_1/pkt_5/lit_d",
         "text": "makrokierunku (elektronika i techniki informacyjne),",
         "children": []
        },
        {
         "type": "lit",
         "num": "e",
         "path": "ust_1/pkt_5/lit_e",
         "text": "makrokierunku (inżynieria środowiska i energetyka),",
         "children": []
        },
        {
         "type": "lit",
         "num": "f",
         "path": "ust_1/pkt_5/lit_f",
         "text": "makrokierunku (technologia i inżynieria chemiczna).",
         "children": []
        }
       ]
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "ust_2",
     "text": "Dla poszczególnych studiów międzykierunkowych określa się następujące wskaźniki kosztochłonności:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "ust_2/pkt_1",
       "text": "k = 1,0 dla międzywydziałowych (międzykierunkowych) s1 studiów humanistycznych;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "ust_2/pkt_2",
       "text": "k s4 = 2,5 dla:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "ust_2/pkt_2/lit_a",
         "text": "międzywydziałowych (międzykierunkowych) studiów matematyczno-przyrodniczych,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "ust_2/pkt_2/lit_b",
         "text": "międzywydziałowych studiów ochrony środowiska.",
         "children": []
        }
       ]
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "ust_3",
     "text": "Dla poszczególnych kierunków, innych niż określone w § 2 rozporządzenia określa się następujące wskaźniki kosztochłonności:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "ust_3/pkt_1",
       "text": "k s1 = 1,0 dla kierunków:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "ust_3/pkt_1/lit_a",
         "text": "artes liberales (Uniwersytet Warszawski),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "ust_3/pkt_1/lit_b",
         "text": "gospodarka i administracja publiczna (Uniwersytet Ekonomiczny w Krakowie),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "ust_3/pkt_1/lit_c",
         "text": "komunikacja europejska (Uniwersytet im. Adama Mickiewicza w Poznaniu),",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "ust_3/pkt_1/lit_d",
         "text": "międzynarodowe stosunki gospodarcze (Uniwersytet Gdański, Uniwersytet Łódzki, Szkoła Główna Handlowa w Warszawie, Uniwersytet Ekonomiczny w Krakowie, Akademia Ekonomiczna w Katowicach, Akademia Ekonomiczna w Poznaniu, Akademia Ekonomiczna we Wrocławiu),",
         "children": []
        },
        {
         "type": "lit",
         "num": "e",
         "path": "ust_3/pkt_1/lit_e",
         "text": "religioznawstwo (Uniwersytet Jagielloński w Krakowie),",
         "children": []
        },
        {
         "type": "lit",
         "num": "f",
         "path": "ust_3/pkt_1/lit_f",
         "text": "wschodoznawstwo (Uniwersytet im. Adama Mickiewicza w Poznaniu);",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "ust_3/pkt_2",
       "text": "k s2 = 1,5 dla kierunków:",
       "children": [
        {
