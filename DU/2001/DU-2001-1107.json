  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Wymagania kwalifikacyjne na poszczególnych stanowiskach Służby Parków Krajobrazowych określa załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Pracownicy zatrudnieni w Służbie Parków Krajobrazowych przed wejściem w życie rozporządzenia, niespełniający wymagań kwalifikacyjnych określonych w rozporządzeniu, mogą zachować dotychczas zajmowane stanowiska.",
   "children": []
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Środowiska: A. Tokarczuk"
