{
 "eli": "DU/2001/1336",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 20 października 2001 r. w sprawie szczegółowego zakresu działania Ministra Infrastruktury.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/1336/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 20 października 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowego zakresu działania Ministra Infrastruktury."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 33 ust. 1 i 1a ustawy z dnia 8 sierpnia 1996 r. o organizacji i trybie pracy Rady Ministrów oraz o zakresie działania ministrów (Dz. U. z 1999 r. Nr 82, poz. 929, z 2000 r. Nr 120, poz. 1268 oraz z 2001 r. Nr 102, poz. 1116) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Rozporządzenie określa szczegółowy zakres działania Ministra Infrastruktury, zwanego dalej „ministrem”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Minister kieruje następującymi działami administracji rządowej:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_2/pkt_1",
       "text": "architektura i budownictwo,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_2/pkt_2",
       "text": "gospodarka morska,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_2/pkt_3",
       "text": "łączność,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/ust_2/pkt_4",
       "text": "gospodarka przestrzenna i mieszkaniowa,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_1/ust_2/pkt_5",
       "text": "transport.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_1/ust_3",
     "text": "Minister jest dysponentem części 18, 21, 26, 27 i 39 budżetu państwa.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_1/ust_4",
     "text": "Obsługę ministra zapewnia Ministerstwo Infrastruktury.",
     "children": []
    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_1/ust_5",
     "text": "Organy i jednostki organizacyjne podległe ministrowi lub przez niego nadzorowane określa załącznik do rozporządzenia.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
