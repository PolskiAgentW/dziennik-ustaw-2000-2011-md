{
 "eli": "DU/2001/951",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 14 sierpnia 2001 r. zmieniające rozporządzenie w sprawie nadania statutu Ministerstwu Zdrowia.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/951/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 14 sierpnia 2001 r."
  },
  {
   "type": "text",
   "text": "zmieniające rozporządzenie w sprawie nadania statutu Ministerstwu Zdrowia."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o organizacji i trybie pracy Rady Ministrów oraz o zakresie działania ministrów (Dz. U. z 1999 r. Nr 82, poz. 929 i z 2000 r. Nr 120, poz. 1268) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "W załączniku do rozporządzenia Prezesa Rady Ministrów z dnia 19 stycznia 2000 r. w sprawie nadania statutu Ministerstwu Zdrowia (Dz. U. Nr 5, poz. 56 i Nr 79, poz. 895) wprowadza się następujące zmiany:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "§ 2 otrzymuje brzmienie:",
     "children": [
      {
       "type": "text",
       "text": "„§ 2. W skład Ministerstwa Zdrowia wchodzą następujące komórki organizacyjne:",
       "quoted": true
      },
      {
       "type": "text",
       "text": "1) Gabinet Polityczny Ministra,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "2) Biuro Ministra,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "3) Departament Zdrowia Publicznego,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "4) Departament Nauki i Kadr Medycznych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "5) Departament Organizacji Ochrony Zdrowia,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "6) Departament Gospodarki Lekami,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "7) Departament Ubezpieczeń Zdrowotnych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "8) Departament Nadzoru i Kontroli,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "9) Departament Budżetu, Finansów i Inwestycji,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "10) Departament Prawny,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "11) Departament Integracji Europejskiej i Współpracy z Zagranicą,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "12) Departament Spraw Obronnych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "13) Biuro Informacji i Promocji,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "14) Biuro Dyrektora Generalnego,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "15) Biuro Administracyjno-Gospodarcze,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "16) Biuro do Spraw Ochrony Informacji Niejawnych.”;",
       "quoted": true
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "w § 3 pkt 4 otrzymuje brzmienie:",
     "children": [
      {
       "type": "text",
       "text": "„4) Departament Gospodarki Lekami,”.",
       "quoted": true
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Buzek"
  }
 ],
 "annexes": [],
