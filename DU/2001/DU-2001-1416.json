{
 "eli": "DU/2001/1416",
 "title": "Rozporządzenie Ministra Edukacji Narodowej z dnia 17 października 2001 r. w sprawie zasad współzawodnictwa sportowego dzieci i młodzieży.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/1416/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA EDUKACJI NARODOWEJ"
  },
  {
   "type": "text",
   "text": "z dnia 17 października 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie zasad współzawodnictwa sportowego dzieci i młodzieży."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 23 ust. 3 ustawy z dnia 18 stycznia 1996 r. o kulturze fizycznej (Dz. U. z 2001 r. Nr 81, poz. 889 i Nr 102, poz. 1115) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Współzawodnictwo sportowe dzieci i młodzieży realizowane jest poprzez:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "zawody sportowe organizowane dla ogółu dzieci i młodzieży szkolnej,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "zawody sportowe organizowane dla dzieci i młodzieży uzdolnionej sportowo.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Współzawodnictwo sportowe obejmuje zawody:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "klubowe,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "międzyklubowe,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "gminne,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "międzygminne,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "powiatowe,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_2/pkt_6",
     "text": "międzypowiatowe,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_2/pkt_7",
     "text": "wojewódzkie,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_2/pkt_8",
     "text": "międzywojewódzkie,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_2/pkt_9",
     "text": "ogólnopolskie.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_3/ust_1",
     "text": "Zawody sportowe dla ogółu dzieci i młodzieży szkolnej mogą być organizowane w formie:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_1/pkt_1",
       "text": "szkolnych zawodów sportowych dla uczniów:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_3/ust_1/pkt_1/lit_a",
         "text": "szkół podstawowych,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_3/ust_1/pkt_1/lit_b",
         "text": "gimnazjów,",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_3/ust_1/pkt_1/lit_c",
         "text": "szkół ponadgimnazjalnych,",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_3/ust_1/pkt_1/lit_d",
         "text": "szkół ponadpodstawowych,",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_1/pkt_2",
       "text": "międzyszkolnych zawodów sportowych, będących kontynuacją zawodów szkolnych.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_3/ust_2",
     "text": "Zawody sportowe, o których mowa w ust. 1, mogą kończyć się finałem wojewódzkim, z zastrzeżeniem ust. 3.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_3/ust_3",
     "text": "Zawody sportowe dla uczniów szkół ponadgimnazjalnych i uczniów szkół ponadpodstawowych w dyscyplinach sportu, w których w danym roku kalendarzowym odbywają się zawody międzynarodowe, mogą kończyć się finałem ogólnopolskim.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_4/ust_1",
     "text": "Zawody sportowe, o których mowa w § 3, odbywają się zgodnie z regulaminem zawodów ustalonym przez organizatora zawodów.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_4/ust_2",
     "text": "Organizatorami zawodów sportowych, o których mowa w § 3, mogą być szkoły oraz stowarzyszenia kultury fizycznej statutowo zajmujące się sportem dzieci i młodzieży.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "5",
   "path": "par_5",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_5/ust_1",
     "text": "Zawody sportowe dla dzieci i młodzieży uzdolnionej sportowo mogą być organizowane w formie:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_5/ust_1/pkt_1",
       "text": "Młodzieżowych Mistrzostw Polski,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_5/ust_1/pkt_2",
       "text": "Mistrzostw Polski Juniorów,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_5/ust_1/pkt_3",
       "text": "Ogólnopolskiej Olimpiady Młodzieży (Mistrzostw Polski Juniorów Młodszych) w sportach zimowych, biegach przełajowych, sportach halowych i sportach letnich,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_5/ust_1/pkt_4",
       "text": "Wojewódzkich lub Międzywojewódzkich Mistrzostw Młodzików.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_5/ust_2",
     "text": "W zawodach sportowych, o których mowa w ust. 1, mogą brać udział dzieci i młodzież, będące członkami klubów sportowych.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_5/ust_3",
     "text": "Udział w finale ogólnopolskim może być poprzedzony eliminacjami.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "6",
   "path": "par_6",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_6/ust_1",
     "text": "Zawody sportowe, o których mowa w § 5, odbywają się zgodnie z regulaminami zawodów dla poszczególnych dyscyplin sportu, ustalonymi przez organizatora zawodów zgodnie z odrębnymi przepisami.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_6/ust_2",
     "text": "Organizatorami zawodów sportowych, o których mowa w § 5, są polskie związki sportowe lub wskazane przez nie związki sportowe albo stowarzyszenia kultury fizycznej.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "7",
   "path": "par_7",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Edukacji Narodowej: E. Wittbrodt"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
