{
 "eli": "DU/2001/274",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 22 marca 2001 r. zmieniające rozporządzenie w sprawie nadania statutu Ministerstwu Rolnictwa i Rozwoju Wsi.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/274/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 22 marca 2001 r."
  },
  {
   "type": "text",
   "text": "zmieniające rozporządzenie w sprawie nadania statutu Ministerstwu Rolnictwa i Rozwoju Wsi."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o organizacji i trybie pracy Rady Ministrów oraz o zakresie działania ministrów (Dz. U. z 1999 r. Nr 82, poz. 929 i z 2000 r. Nr 120, poz. 1268) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "W rozporządzeniu Prezesa Rady Ministrów z dnia 7 marca 2000 r. w sprawie nadania statutu Ministerstwu Rolnictwa i Rozwoju Wsi (Dz. U. Nr 16, poz. 208) w załączniku wprowadza się następujące zmiany:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "§ 2 otrzymuje brzmienie:",
     "children": [
      {
       "type": "text",
       "text": "„§ 2. W skład Ministerstwa Rolnictwa i Rozwoju Wsi wchodzą następujące komórki organizacyjne:",
       "quoted": true
      },
      {
       "type": "text",
       "text": "1) Gabinet Polityczny Ministra,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "2) Departament Budżetu i Finansów,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "3) Departament Gospodarki Ziemią,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "4) Departament Integracji Europejskiej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "5) Departament Polityki Rolnej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "6) Departament Pomocy Przedakcesyjnej i Funduszy Strukturalnych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "7) Departament Produkcji Roślinnej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "8) Departament Produkcji Zwierzęcej i Weterynarii,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "9) Departament Rozwoju Wsi,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "10) Departament Rybołówstwa,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "11) Departament Rynków Rolnych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "12) Departament Spraw Obronnych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "13) Departament Współpracy z Zagranicą,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "14) Biuro Dyrektora Generalnego,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "15) Biuro Kontroli, Skarg i Wniosków,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "16) Biuro Nauki,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "17) Biuro Ochrony Informacji Niejawnych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "18) Biuro Prawne,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "19) Biuro Prasowe,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "20) Biuro Administracyjno-Budżetowe.”;",
       "quoted": true
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "w § 3 pkt 1 otrzymuje brzmienie:",
     "children": [
      {
       "type": "text",
       "text": "„1) w zakresie działu rolnictwo:",
       "quoted": true
      },
      {
       "type": "text",
       "text": "a) Departament Polityki Rolnej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "b) Departament Produkcji Roślinnej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "c) Departament Produkcji Zwierzęcej i Weterynarii,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "d) Departament Rybołówstwa,”.",
       "quoted": true
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Buzek"
  }
 ],
