{
 "eli": "DU/2001/4",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 8 stycznia 2001 r. w sprawie nadania statutu Ministerstwu Edukacji Narodowej.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/4/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 8 stycznia 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Edukacji Narodowej."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o organizacji i trybie pracy Rady Ministrów oraz o zakresie działania ministrów (Dz. U. z 1999 r. Nr 82, poz. 929 i z 2000 r. Nr 120, poz. 1268) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Edukacji Narodowej nadaje się statut, stanowiący załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc rozporządzenie Prezesa Rady Ministrów z dnia 22 kwietnia 1997 r. w sprawie nadania statutu Ministerstwu Edukacji Narodowej (Dz. U. Nr 40, poz. 249 i z 1998 r. Nr 12, poz. 43).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Buzek"
  }
 ],
 "annexes": [
  {
