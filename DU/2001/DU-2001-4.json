   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA EDUKACJI NARODOWEJ"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Edukacji Narodowej, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Edukacji Narodowej, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 30 listopada 1999 r. w sprawie szczegółowego zakresu działania Ministra Edukacji Narodowej (Dz. U. Nr 96, poz. 1117 oraz z 2000 r. Nr 8, poz. 92 i Nr 94, poz. 1038), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "kultury fizycznej i sportu,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "oświaty i wychowania,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "szkolnictwa wyższego.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "2",
