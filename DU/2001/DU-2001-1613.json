{
 "eli": "DU/2001/1613",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 11 grudnia 2001 r. w sprawie wprowadzenia i odwołania czasu letniego w latach 2002-2006.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/1613/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 11 grudnia 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie wprowadzenia i odwołania czasu letniego w latach 2002—2006."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 2 ustawy z dnia 18 stycznia 1996 r. o czasie letnim (Dz. U. Nr 29, poz. 128) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Czas letni wprowadza się:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_1/pkt_1",
       "text": "w 2002 r. — dnia 31 marca,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_1/pkt_2",
       "text": "w 2003 r. — dnia 30 marca,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_1/pkt_3",
       "text": "w 2004 r. — dnia 28 marca,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/ust_1/pkt_4",
       "text": "w 2005 r. — dnia 27 marca,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_1/ust_1/pkt_5",
       "text": "w 2006 r. — dnia 26 marca",
       "children": [
        {
         "type": "text",
         "text": "— o godzinie 2 minut 00 czasu środkowoeuropejskiego (o godzinie 1 minut 00 czasu Greenwich Mean Time)."
        }
       ]
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Wprowadzenie czasu letniego polega na zmianie wskazań zegarów z godziny 2 minut 00 na godzinę 3 minut 00, która będzie godziną początkową czasu letniego (wschodnioeuropejskiego).",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_2/ust_1",
     "text": "Czas letni odwołuje się:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_2/ust_1/pkt_1",
       "text": "w 2002 r. — dnia 27 października,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_2/ust_1/pkt_2",
       "text": "w 2003 r. — dnia 26 października,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_2/ust_1/pkt_3",
       "text": "w 2004 r. — dnia 31 października,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_2/ust_1/pkt_4",
       "text": "w 2005 r. — dnia 30 października,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_2/ust_1/pkt_5",
       "text": "w 2006 r. — dnia 29 października",
       "children": [
        {
         "type": "text",
         "text": "— o godzinie 3 minut 00 czasu wschodnioeuropejskiego (o godzinie 1 minut 00 czasu Greenwich Mean Time)."
        }
       ]
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_2/ust_2",
     "text": "Odwołanie czasu letniego polega na zmianie wskazań zegarów z godziny 3 minut 00 na godzinę 2 minut 00 (godzina 1 minut 00 czasu Greenwich Mean Time), która będzie godziną początkową czasu środkowoeuropejskiego.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_2/ust_3",
     "text": "Czas od godziny 2 minut 00 do godziny 3 minut 00 czasu środkowoeuropejskiego będzie się oznaczać dodatkową literą „a” (godzina 2a minut 01 do godziny 3a minut 00), po czym nastąpi godzina 3 minut 01 czasu środkowoeuropejskiego.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem 1 stycznia 2002 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
