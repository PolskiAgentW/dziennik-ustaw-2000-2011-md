{
 "eli": "DU/2001/1847",
 "title": "Rozporządzenie Ministra Obrony Narodowej z dnia 14 grudnia 2001 r. w sprawie dodatkowego umundurowania, uzbrojenia i wyposażenia żołnierzy Żandarmerii Wojskowej.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/1847/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA OBRONY NARODOWEJ"
  },
  {
   "type": "text",
   "text": "z dnia 14 grudnia 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie dodatkowego umundurowania, uzbrojenia i wyposażenia żołnierzy Żandarmerii Wojskowej."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 9 ust. 3 ustawy z dnia 24 sierpnia 2001 r. o Żandarmerii Wojskowej i wojskowych organach porządkowych (Dz. U. Nr 123, poz. 1353 i Nr 154, poz. 1800) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rozporządzenie określa dodatkowe umundurowanie, uzbrojenie i wyposażenie żołnierzy Żandarmerii Wojskowej niezbędne do wykonywania zadań służbowych.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Żołnierze Żandarmerii Wojskowej otrzymują dodatkowe:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "przedmioty zaopatrzenia mundurowego:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_1/lit_a",
       "text": "pasy białe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_1/lit_b",
       "text": "koalicyjki białe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_1/lit_c",
       "text": "rękawiczki białe,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "przedmioty ubioru cywilnego:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_2/lit_a",
       "text": "czapki, kapelusze,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_2/lit_b",
       "text": "garnitury, kurtki i płaszcze,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_2/lit_c",
       "text": "spodnie i swetry,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_2/lit_d",
       "text": "koszule,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_2/lit_e",
       "text": "obuwie,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "wyposażenie specjalistyczne:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_3/lit_a",
       "text": "pałki wielofunkcyjne,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_3/lit_b",
       "text": "kajdanki metalowe i jednorazowego użytku,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_3/lit_c",
       "text": "kaski interwencyjne z osłoną twarzy i karku,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_3/lit_d",
       "text": "kamizelki ochronne: odblaskowe i kuloodporne,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_3/lit_e",
       "text": "pasy obezwładniające i prowadnice,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_2/pkt_3/lit_f",
       "text": "tarcze sygnałowe zwykłe, odblaskowe, podświetlane,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_2/pkt_3/lit_g",
       "text": "zestawy do organizacji blokady drogowej, kolczatki,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_2/pkt_3/lit_h",
       "text": "urządzenia do blokowania kół pojazdów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "i",
       "path": "par_2/pkt_3/lit_i",
       "text": "urządzenia do pomiaru prędkości pojazdów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "j",
       "path": "par_2/pkt_3/lit_j",
       "text": "urządzenia do pomiaru zawartości alkoholu w wydychanym powietrzu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "k",
       "path": "par_2/pkt_3/lit_k",
       "text": "urządzenia i środki do wykrywania materiałów wybuchowych i narkotyków,",
       "children": []
      },
      {
       "type": "lit",
       "num": "l",
       "path": "par_2/pkt_3/lit_l",
       "text": "sprzęt do wykrywania urządzeń podsłuchowych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "m",
       "path": "par_2/pkt_3/lit_m",
       "text": "aparaty fotograficzne i kamery do dokumentowania zdarzeń kryminalistycznych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "n",
       "path": "par_2/pkt_3/lit_n",
       "text": "urządzenia do wykonywania ekspertyz kryminalistycznych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "o",
       "path": "par_2/pkt_3/lit_o",
       "text": "sprzęt do pracy operacyjno-rozpoznawczej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "p",
       "path": "par_2/pkt_3/lit_p",
       "text": "paralizatory elektryczne,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "uzbrojenie:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_4/lit_a",
       "text": "pistolety, rewolwery, broń gładkolufowa wzorów innych niż będące na wyposażeniu Sił Zbrojnych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_4/lit_b",
       "text": "kabury do broni koloru białego i kabury operacyjne,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_4/lit_c",
       "text": "przedmioty przeznaczone do miotania chemicznych innych środków obezwładniających: pistolety i rewolwery gazowe, miotacze gazu, wyrzutnie granatów i pocisków łzawiących oraz siatek obezwładniających.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Wzory umundurowania oraz typy i normy wyposażenia specjalistycznego i uzbrojenia inne niż będące na wyposażeniu Sił Zbrojnych są ustalane przez Komendanta Głównego Żandarmerii Wojskowej.",
   "children": []
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Dodatkowe uzbrojenie i wyposażenie żołnierzy Żandarmerii Wojskowej wyznaczonych do pełnienia służby prewencyjnej ustala komendant jednostki organizacyjnej Żandarmerii Wojskowej.",
   "children": []
  },
  {
   "type": "par",
   "num": "5",
   "path": "par_5",
   "text": "Rozporządzenie wchodzi w życie z dniem 1 stycznia 2002 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Obrony Narodowej: J. Szmajdziński"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
