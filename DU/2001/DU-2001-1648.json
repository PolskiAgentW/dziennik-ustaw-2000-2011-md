       "children": []
      },
      {
       "type": "pkt",
       "num": "12",
       "path": "par_4/pkt_12",
       "text": "Biuro Dyrektora Generalnego Urzędu.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "5",
     "path": "par_5",
     "text": "",
     "children": [
      {
       "type": "ust",
       "num": "1",
       "path": "par_5/ust_1",
       "text": "Prezesowi podlegają dyrektorzy urzędów statystycznych.",
       "children": []
      },
      {
       "type": "ust",
       "num": "2",
       "path": "par_5/ust_2",
       "text": "Prezesowi są podporządkowane:",
       "children": [
        {
         "type": "pkt",
         "num": "1",
         "path": "par_5/ust_2/pkt_1",
         "text": "Zakład Badań Statystyczno-Ekonomicznych Głównego Urzędu Statystycznego i Polskiej Akademii Nauk,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "2",
         "path": "par_5/ust_2/pkt_2",
         "text": "Centralna Biblioteka Statystyczna im. Stefana Szulca,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "3",
         "path": "par_5/ust_2/pkt_3",
         "text": "Centralny Ośrodek Informatyki Statystycznej,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "4",
         "path": "par_5/ust_2/pkt_4",
         "text": "Ośrodek Szkolenia Kadr Statystyki,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "5",
         "path": "par_5/ust_2/pkt_5",
         "text": "Ośrodek Szkoleń Informatycznych Statystyki,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "6",
         "path": "par_5/ust_2/pkt_6",
         "text": "Zakład Wydawnictw Statystycznych.",
         "children": []
        }
       ]
      }
     ]
    },
    {
     "type": "par",
     "num": "6",
     "path": "par_6",
     "text": "",
     "children": [
      {
       "type": "ust",
       "num": "1",
       "path": "par_6/ust_1",
       "text": "W Urzędzie działa, jako jednostka wyodrębniona, gospodarstwo pomocnicze „Zakład Obsługi Głównego Urzędu Statystycznego”.",
       "children": []
      },
      {
       "type": "ust",
       "num": "2",
       "path": "par_6/ust_2",
       "text": "Organizację wewnętrzną, szczegółowy zakres zadań oraz tryb pracy gospodarstwa pomocniczego określają odrębne przepisy oraz regulamin wewnętrzny zatwierdzony przez Dyrektora Generalnego.",
       "children": []
      }
     ]
    }
   ]
  }
 ],
