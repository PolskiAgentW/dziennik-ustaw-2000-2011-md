 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA GOSPODARKI"
  },
  {
   "type": "text",
   "text": "z dnia 17 października 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowego wykazu paliw ciekłych, w zakresie których tworzy się zapasy obowiązkowe."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 17 ust. 3 ustawy z dnia 30 maja 1996 r. o rezerwach państwowych oraz zapasach obowiązkowych paliw (Dz. U. Nr 90, poz. 404 i Nr 156, poz. 775, z 1997 r. Nr 121, poz. 770 oraz z 2000 r. Nr 43, poz. 487) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Obowiązek tworzenia i utrzymywania zapasów obowiązkowych paliw ciekłych dotyczy paliw oznaczonych następującymi kodami PCN:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "benzyn:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_1/lit_a",
       "text": "silnikowych bezołowiowych: 2710 00 27 0 2710 00 29 0 2710 00 32 0",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_1/lit_b",
       "text": "silnikowych ołowiowych: 2710 00 34 0 2710 00 36 0",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_1/lit_c",
       "text": "lotniczych 2710 00 26 0 2710 00 37 0",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "olejów napędowych, w tym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_2/lit_a",
       "text": "olejów napędowych do silników: 2710 00 66 1 2710 00 67 1 2710 00 68 1",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_2/lit_b",
       "text": "materiałów pędnych do silników lotniczych na bazie nafty: 2710 00 51 0",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_1/pkt_3",
     "text": "ropy naftowej 2709 00 90 0.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Gospodarki: J. Steinhoff"
  }
 ],
