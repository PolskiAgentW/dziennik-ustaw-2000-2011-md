  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Do wód termalnych zalicza się wody podziemne pochodzące ze wszystkich jednostek geologicznych, posiadające na wypływie z ujęcia temperaturę co najmniej 20°C, z wyjątkiem wód odprowadzanych z odwodnienia czynnych zakładów górniczych i odwodnienia nieczynnych wyrobisk.",
   "children": []
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Do kopalin leczniczych zalicza się torfy ze złoża:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_4/pkt_1",
     "text": "„Bronowo” w miejscowości Bronowo, w województwie zachodniopomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_4/pkt_2",
     "text": "„Bronów” w miejscowości Podlas, w województwie śląskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_4/pkt_3",
     "text": "„Dziwogóra” w miejscowości Ludzicko, w województwie zachodniopomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_4/pkt_4",
     "text": "„Izera-Skalno” w Górach Izerskich, w województwie dolnośląskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_4/pkt_5",
     "text": "„Jakuszyce” w miejscowości Szklarska Poręba, w województwie dolnośląskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_4/pkt_6",
     "text": "„Kamień Pomorski” w uzdrowisku Kamień Pomorski, w województwie zachodniopomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_4/pkt_7",
     "text": "„Kołobrzeg” w uzdrowisku Kołobrzeg, w województwie zachodniopomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_4/pkt_8",
     "text": "„Majdan Wielki I” w miejscowości Majdan Wielki, w województwie lubelskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_4/pkt_9",
     "text": "„Międzyzdroje” w miejscowości Międzyzdroje, w województwie zachodniopomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_4/pkt_10",
     "text": "„Niedrzwica II” w miejscowości Niedrzwica, w województwie warmińsko-mazurskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "11",
     "path": "par_4/pkt_11",
     "text": "„Podemszczyzna” w miejscowości Podemszczyzna, w województwie podkarpackim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "12",
     "path": "par_4/pkt_12",
     "text": "„Podsokołda” w miejscowości Podsokołda, w województwie podlaskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "13",
     "path": "par_4/pkt_13",
     "text": "„Płachcin” w uzdrowisku Świnoujście, w województwie zachodniopomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "14",
     "path": "par_4/pkt_14",
     "text": "„Rudołtowice” w miejscowości Pszczyna, w województwie śląskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "15",
     "path": "par_4/pkt_15",
     "text": "„Ustka” w uzdrowisku i gminie Ustka, w województwie pomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "16",
     "path": "par_4/pkt_16",
     "text": "„Wieniec” w uzdrowisku Wieniec, w województwie kujawsko-pomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "17",
     "path": "par_4/pkt_17",
     "text": "„Wojdal V” w miejscowości Wojdal, w województwie kujawsko-pomorskim,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "18",
     "path": "par_4/pkt_18",
     "text": "„Zabłocie” w miejscowości Zabłocie, w województwie śląskim.",
     "children": []
    }
   ]
  },
