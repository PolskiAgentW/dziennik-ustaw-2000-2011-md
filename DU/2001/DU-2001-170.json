{
 "eli": "DU/2001/170",
 "title": "Rozporządzenie Rady Ministrów z dnia 20 lutego 2001 r. w sprawie wykazu gmin górniczych.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/170/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 20 lutego 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie wykazu gmin górniczych."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 3 ust. 2 ustawy z dnia 26 listopada 1998 r. o dostosowaniu górnictwa węgla kamiennego do funkcjonowania w warunkach gospodarki rynkowej oraz szczególnych uprawnieniach i zadaniach gmin górniczych (Dz. U. Nr 162, poz. 1112 i z 2001 r. Nr 5, poz. 41) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ustala się wykaz gmin górniczych stanowiący załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Buzek"
  }
 ],
