{
 "eli": "DU/2001/620",
 "title": "Rozporządzenie Ministra Zdrowia z dnia 22 maja 2001 r. w sprawie wykazu chorób zakaźnych.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2001/620/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ZDROWIA"
  },
  {
   "type": "text",
   "text": "z dnia 22 maja 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie wykazu chorób zakaźnych."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 1 ust. 3 ustawy z dnia 13 listopada 1963 r. o zwalczaniu chorób zakaźnych (Dz. U. Nr 50, poz. 279, z 1971 r. Nr 12, poz. 115, z 1974 r. Nr 47, poz. 280, z 1989 r. Nr 35, poz. 192, z 1990 r. Nr 34, poz. 198, z 1997 r. Nr 60, poz. 369, z 1998 r. Nr 106, poz. 668 oraz z 2000 r. Nr 12, poz. 136 i Nr 120, poz. 1268) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ustala się wykaz chorób zakaźnych:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "biegunki dzieci do lat 2,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "błonica,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_1/pkt_3",
     "text": "borelioza (choroba z Lyme, krętkownica kleszczowa),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_1/pkt_4",
     "text": "bruceloza,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_1/pkt_5",
     "text": "cholera,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_1/pkt_6",
     "text": "choroba Creutzfeldta-Jakoba i inne encefalopatie gąbczaste,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_1/pkt_7",
     "text": "czerwonka bakteryjna,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_1/pkt_8",
     "text": "dur brzuszny i zakażenia pałeczkami durowymi,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_1/pkt_9",
     "text": "dur plamisty i inne riketsjozy,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_1/pkt_10",
     "text": "dury rzekome A, B, C i zakażenia pałeczkami rzekomodurowymi,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "11",
     "path": "par_1/pkt_11",
     "text": "dżuma,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "12",
     "path": "par_1/pkt_12",
     "text": "gorączka powrotna,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "13",
     "path": "par_1/pkt_13",
     "text": "grypa,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "14",
     "path": "par_1/pkt_14",
     "text": "grzybica woszczynowa, strzygąca, drobnozarodnikowa,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "15",
     "path": "par_1/pkt_15",
     "text": "jaglica,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "16",
     "path": "par_1/pkt_16",
     "text": "krztusiec,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "17",
     "path": "par_1/pkt_17",
     "text": "listerioza,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "18",
     "path": "par_1/pkt_18",
     "text": "nagminne porażenie dziecięce oraz ostre porażenia wiotkie (w tym zespół Guillaina-Barrego),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "19",
     "path": "par_1/pkt_19",
     "text": "nagminne zapalenie przyusznicy,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "20",
     "path": "par_1/pkt_20",
     "text": "nosacizna,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "21",
     "path": "par_1/pkt_21",
     "text": "odra,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "22",
     "path": "par_1/pkt_22",
     "text": "ospa wietrzna,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "23",
     "path": "par_1/pkt_23",
     "text": "paciorkowcowe zapalenie gardła,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "24",
     "path": "par_1/pkt_24",
     "text": "papuzia choroba i inne ornitozy,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "25",
     "path": "par_1/pkt_25",
     "text": "pełzakowica,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "26",
     "path": "par_1/pkt_26",
     "text": "płonica,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "27",
     "path": "par_1/pkt_27",
     "text": "pryszczyca,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "28",
     "path": "par_1/pkt_28",
     "text": "róża,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "29",
     "path": "par_1/pkt_29",
     "text": "różyca,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "30",
     "path": "par_1/pkt_30",
     "text": "różyczka,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "31",
     "path": "par_1/pkt_31",
     "text": "salmonelozy odzwierzęce,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "32",
     "path": "par_1/pkt_32",
     "text": "świerzb,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "33",
     "path": "par_1/pkt_33",
     "text": "tasiemczyce i inne choroby wywołane przez larwy tasiemców,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "34",
     "path": "par_1/pkt_34",
     "text": "tężec,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "35",
     "path": "par_1/pkt_35",
     "text": "toksoplazmoza,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "36",
     "path": "par_1/pkt_36",
     "text": "trąd,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "37",
     "path": "par_1/pkt_37",
     "text": "tularemia,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "38",
     "path": "par_1/pkt_38",
     "text": "twardziel,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "39",
     "path": "par_1/pkt_39",
     "text": "wąglik,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "40",
     "path": "par_1/pkt_40",
     "text": "włośnica,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "41",
     "path": "par_1/pkt_41",
     "text": "wścieklizna bądź pokąsanie osób przez zwierzęta podejrzane o wściekliznę lub zanieczyszczenie śliną tych zwierząt,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "42",
     "path": "par_1/pkt_42",
     "text": "zakażenia wirusami hepatotropowymi (HAV, HBV, HCV, HDV, HEV),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "43",
     "path": "par_1/pkt_43",
     "text": "zapalenie mózgu,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "44",
     "path": "par_1/pkt_44",
     "text": "zapalenie opon mózgowo-rdzeniowych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "45",
     "path": "par_1/pkt_45",
     "text": "zatrucie i zakażenie pokarmowe,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "46",
     "path": "par_1/pkt_46",
     "text": "zespół nabytego upośledzenia odporności (AIDS) i zakażenie HIV,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "47",
     "path": "par_1/pkt_47",
     "text": "zimnica,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "48",
     "path": "par_1/pkt_48",
     "text": "żółta gorączka i inne wirusowe gorączki krwotoczne,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "49",
     "path": "par_1/pkt_49",
     "text": "żółtaczka zakaźna krętkowa i inne zakażenia krętkowe.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc § 1 rozporządzenia Rady Ministrów z dnia 20 grudnia 1963 r. w sprawie ustalenia wykazów chorób zakaźnych (Dz. U. Nr 58, poz. 314, z 1977 r. Nr 30, poz. 133 i z 1986 r. Nr 40, poz. 197).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Zdrowia: G. Opala"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
