        },
        {
         "type": "lit",
         "num": "j",
         "path": "par_1/ust_1/pkt_2/lit_j",
         "text": "zając szarak (Lepus europaeus),",
         "children": []
        },
        {
         "type": "lit",
         "num": "k",
         "path": "par_1/ust_1/pkt_2/lit_k",
         "text": "dziki królik (Oryctolagus cuniculus),",
         "children": []
        },
        {
         "type": "lit",
         "num": "l",
         "path": "par_1/ust_1/pkt_2/lit_l",
         "text": "jarząbek (Tetrastes bonasia),",
         "children": []
        },
        {
         "type": "lit",
         "num": "m",
         "path": "par_1/ust_1/pkt_2/lit_m",
         "text": "bażant (Phasianus ssp.),",
         "children": []
        },
        {
         "type": "lit",
         "num": "n",
         "path": "par_1/ust_1/pkt_2/lit_n",
         "text": "kuropatwa (Perdix perdix),",
         "children": []
        },
        {
         "type": "lit",
         "num": "o",
         "path": "par_1/ust_1/pkt_2/lit_o",
         "text": "gęś gęgawa (Anser anser),",
         "children": []
        },
        {
         "type": "lit",
         "num": "p",
         "path": "par_1/ust_1/pkt_2/lit_p",
         "text": "gęś zbożowa (Anser fabalis),",
         "children": []
        },
        {
         "type": "lit",
         "num": "r",
         "path": "par_1/ust_1/pkt_2/lit_r",
         "text": "gęś białoczelna (Anser albifrons),",
         "children": []
        },
        {
         "type": "lit",
         "num": "s",
         "path": "par_1/ust_1/pkt_2/lit_s",
         "text": "krzyżówka (Anas platyrhynchos),",
         "children": []
        },
        {
         "type": "lit",
         "num": "t",
         "path": "par_1/ust_1/pkt_2/lit_t",
