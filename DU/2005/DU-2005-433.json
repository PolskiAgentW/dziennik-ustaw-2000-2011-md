 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ŚRODOWISKA[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 11 marca 2005 r."
  },
  {
   "type": "text",
   "text": "w sprawie ustalenia listy gatunków zwierząt łownych"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 5 ustawy z dnia 13 października 1995 r. — Prawo łowieckie (Dz. U. z 2002 r. Nr 42, poz. 372, z późn. zm.[^2]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Ustala się następującą listę gatunków zwierząt łownych:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_1/pkt_1",
       "text": "zwierzyna gruba:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_1/ust_1/pkt_1/lit_a",
         "text": "łoś (Alces alces),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_1/ust_1/pkt_1/lit_b",
         "text": "jeleń szlachetny (Cervus elaphus),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_1/ust_1/pkt_1/lit_c",
         "text": "jeleń sika (Cervus nippon),",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_1/ust_1/pkt_1/lit_d",
         "text": "daniel (Dama dama),",
         "children": []
        },
        {
         "type": "lit",
         "num": "e",
         "path": "par_1/ust_1/pkt_1/lit_e",
         "text": "sarna (Capreolus capreolus),",
         "children": []
        },
        {
         "type": "lit",
         "num": "f",
         "path": "par_1/ust_1/pkt_1/lit_f",
         "text": "dzik (Sus scrofa),",
         "children": []
        },
        {
         "type": "lit",
         "num": "g",
         "path": "par_1/ust_1/pkt_1/lit_g",
         "text": "muflon (Ovis aries musimon);",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_1/pkt_2",
       "text": "zwierzyna drobna:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_1/ust_1/pkt_2/lit_a",
         "text": "lis (Vulpes vulpes),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_1/ust_1/pkt_2/lit_b",
         "text": "jenot (Nyctereutes procyonoides),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_1/ust_1/pkt_2/lit_c",
         "text": "borsuk (Meles meles),",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_1/ust_1/pkt_2/lit_d",
         "text": "kuna leśna (Martes martes),",
         "children": []
        },
        {
         "type": "lit",
         "num": "e",
         "path": "par_1/ust_1/pkt_2/lit_e",
         "text": "kuna domowa (Martes foina),",
         "children": []
        },
        {
         "type": "lit",
         "num": "f",
         "path": "par_1/ust_1/pkt_2/lit_f",
         "text": "norka amerykańska (Mustela vison),",
         "children": []
        },
        {
         "type": "lit",
         "num": "g",
         "path": "par_1/ust_1/pkt_2/lit_g",
         "text": "tchórz zwyczajny (Mustela putorius),",
         "children": []
        },
        {
         "type": "lit",
         "num": "h",
         "path": "par_1/ust_1/pkt_2/lit_h",
         "text": "szop pracz (Procyon lotor),",
         "children": []
        },
        {
         "type": "lit",
         "num": "i",
         "path": "par_1/ust_1/pkt_2/lit_i",
         "text": "piżmak (Ondatra zibethicus),",
