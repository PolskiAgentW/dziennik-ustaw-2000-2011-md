{
 "eli": "DU/2005/765",
 "title": "Rozporządzenie Ministra Środowiska z dnia 18 maja 2005 r. w sprawie parków narodowych lub niektórych ich obszarów, gdzie za wstęp pobiera się opłaty",
 "converter": "eli2md 0.6.18",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2005/765/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ŚRODOWISKA[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 18 maja 2005 r."
  },
  {
   "type": "text",
   "text": "w sprawie parków narodowych lub niektórych ich obszarów, gdzie za wstęp pobiera się opłaty"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 12 ust. 10 ustawy z dnia 16 kwietnia 2004 r. o ochronie przyrody (Dz. U. Nr 92, poz. 880) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Określa się następujące parki narodowe, gdzie za wstęp pobiera się opłaty:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "Biebrzański Park Narodowy;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "Park Narodowy „Bory Tucholskie”;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_1/pkt_3",
     "text": "Bieszczadzki Park Narodowy;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_1/pkt_4",
     "text": "Karkonoski Park Narodowy;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_1/pkt_5",
     "text": "Narwiański Park Narodowy;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_1/pkt_6",
     "text": "Tatrzański Park Narodowy;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_1/pkt_7",
     "text": "Wielkopolski Park Narodowy;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_1/pkt_8",
     "text": "Wigierski Park Narodowy.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Określa się parki narodowe, gdzie za wstęp na niektóre ich obszary pobiera się opłaty:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "w Babiogórskim Parku Narodowym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_1/lit_a",
       "text": "szlak czerwony na odcinku Polana Krowiarki — Diablak,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_1/lit_b",
       "text": "szlak niebieski na odcinku Polana Krowiarki — Markowe Szczawiny,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_1/lit_c",
       "text": "szlak czerwony na odcinku Markowe Szczawiny — Diablak,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_1/lit_d",
       "text": "szlak żółty na odcinku Markowe Szczawiny — Diablak,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_1/lit_e",
       "text": "szlak zielony na odcinku Zawoja Markowa — Markowe Szczawiny;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "w Białowieskim Parku Narodowym — obszar ochrony ścisłej — obwód ochronny Sierchanowo;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "w Drawieńskim Parku Narodowym — szlak wodny na rzece Drawie na odcinku Drawno — Osieczno;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "w Gorczańskim Parku Narodowym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_4/lit_a",
       "text": "szlak w dolinie Potoku Turbacz na odcinku Polana Hucisko — Olszowy Potok,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_4/lit_b",
       "text": "szlak w dolinie Olszowego Potoku na odcinku Polana Hucisko — Poręba Górna,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_4/lit_c",
       "text": "szlak niebieski na odcinku Polana Hucisko — Turbacz,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_4/lit_d",
       "text": "szlak zielony na odcinku Polana Tobołów — Obidowiec,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_4/lit_e",
       "text": "obszar na ścieżkach przyrodniczych o nazwach:",
       "children": [
        {
         "type": "text",
         "text": "— „Dolina Potoku Turbacz”,"
        },
        {
         "type": "text",
         "text": "— „Na Turbaczyk”,"
        },
        {
         "type": "text",
         "text": "— „Wokół Doliny Poręby”;"
        }
       ]
      }
     ]
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "w Parku Narodowym Gór Stołowych:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_5/lit_a",
       "text": "obszar Szczelińca Wielkiego (oddział 41 h),",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_5/lit_b",
       "text": "obszar Błędnych Skał (oddział 116 d,f,g,h,j,k);",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_2/pkt_6",
     "text": "w Pienińskim Parku Narodowym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_6/lit_a",
       "text": "szlak wodny w Przełomie Dunajca na odcinku Sromowce Niżne — Szczawnica,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_6/lit_b",
       "text": "galeria widokowa na Trzech Koronach (oddział 26 L1),",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_6/lit_c",
       "text": "galeria widokowa na Sokolicy (oddział 10 g i 3 f);",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_2/pkt_7",
     "text": "w Poleskim Parku Narodowym — obszary na ścieżkach przyrodniczych o nazwach:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_7/lit_a",
       "text": "„Dąb Dominik” (oddział 101 i, 102 l,o, 137 a,g,i,j, o,p, 138 a, 140 z,c x i 161 d,h,n,p),",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_7/lit_b",
       "text": "„Spławy” (oddział 245 l, 253 a,b,c,f,g,h,j, 254 b,c, 255 g, 261 b ,c ,y i 262 d,j,k,o ,r ,s ,n ,j ),",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_7/lit_c",
       "text": "„Perehod” (oddział 11 a,b,c,d,f,g,j,k,l,m,o,p,r,s,t, w,x,y,z,f x i 12 a,c,g,h,j,k);",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_2/pkt_8",
     "text": "w Magurskim Parku Narodowym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_8/lit_a",
       "text": "graniczny szlak niebieski na odcinku Ożenna — Huta Polańska — Baranie,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_8/lit_b",
       "text": "beskidzki szlak czerwony na odcinku Bartne — Wątkowa — Magura — Świerzowa — Kolanin — Kamień — Kąty,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_8/lit_c",
       "text": "szlak zielony na odcinku Wapienne — Magura Wątkowska — Folusz — Mrukowa — Kąty — Kamień — Krempna — Wysokie — Ożenna,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_8/lit_d",
       "text": "trasa konna na odcinku Nieznajowa — Rostajne — Kotań — Huta Krempska — Polany;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_2/pkt_9",
     "text": "w Roztoczańskim Parku Narodowym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_9/lit_a",
       "text": "ścieżka przyrodnicza na Bukową Górę (oddział 188 a,b,c,d,j,i, 197 a,b,c, 198 c, 209 a,b,c),",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_9/lit_b",
       "text": "trasa rowerowa Zwierzyniec — Florianka — Górecko Kościelne (oddział 187 k,j,n,g,p,r, 206 a, c,g,h,i,j, 195 f,g,d,z,ax,cx,dx,fx, 204 m, 217 c, 224 f,g,h, 236 f,i, 247 d,f,c,g,m, 261 a,d,c,f,g, 275 b, 276 a,c,h,d,f, 278 f,k, 293 b,c,d,f,h,i,k,m, 277 g,h,d, 295 a,k,o,h,i, 294 b,i,j, 306 a,g,i,b,d, h,j, 317 a,d, 326 a,b,c);",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_2/pkt_10",
     "text": "w Słowińskim Parku Narodowym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_10/lit_a",
       "text": "obwód ochronny Rąbka,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_10/lit_b",
       "text": "obwód ochronny Smołdziński Las,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_10/lit_c",
       "text": "obwód ochronny Rowy,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_10/lit_d",
       "text": "obwód ochronny Kluki,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_10/lit_e",
       "text": "Jezioro Łebsko,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_2/pkt_10/lit_f",
       "text": "Jezioro Gardno;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "11",
     "path": "par_2/pkt_11",
     "text": "w Świętokrzyskim Parku Narodowym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_11/lit_a",
       "text": "szlak czerwony na odcinkach: Święta Katarzyna — Huta Szklana; Święty Krzyż —Trzcianka,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_11/lit_b",
       "text": "szlak niebieski na odcinku Nowa Słupia — Święty Krzyż,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_11/lit_c",
       "text": "galeria widokowa na gołoborzu na Łysej Górze (oddział 116 f,g);",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "12",
     "path": "par_2/pkt_12",
     "text": "w Parku Narodowym „Ujście Warty”— obszary na ścieżkach przyrodniczych o nazwach:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_12/lit_a",
       "text": "„Ptasim szlakiem”,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_12/lit_b",
       "text": "„Mokradła”;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "13",
     "path": "par_2/pkt_13",
     "text": "w Wolińskim Parku Narodowym:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_13/lit_a",
       "text": "punkt widokowy Gosań (oddział 14 d,f,k,o),",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_13/lit_b",
       "text": "punkt widokowy Zielonka — Jezioro Turkusowe (oddział 128, 128 A),",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_13/lit_c",
       "text": "punkt widokowy Kawcza Góra — Biała Góra (oddział 16, 15 B),",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_13/lit_d",
       "text": "plaża Międzyzdroje (oddział 16 z),",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_13/lit_e",
       "text": "plaża Wisełka (oddział 6 r, 7 s, 4 bx, 5 p),",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_2/pkt_13/lit_f",
       "text": "plaża Świętouść (oddział 1 Aa, 1 Ca).",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": [
    {
     "type": "text",
     "text": "Minister Środowiska: w z. T. Podgajniak"
    }
   ]
  }
 ],
 "annexes": [],
 "footnotes": {
  "1": "Minister Środowiska kieruje działem administracji rządowej — środowisko, na podstawie § 1 ust. 2 pkt 2 rozporządzenia Prezesa Rady Ministrów z dnia 11 czerwca 2004 r. w sprawie szczegółowego zakresu działania Ministra Środowiska (Dz. U. Nr 134, poz. 1438). x x x x x x x x"
 }
}
