  {
   "heading": "Załącznik nr 8",
   "body": [
    {
     "type": "text",
     "text": "OKRESY UŻYTKOWANIA CZĘŚCI UMUNDUROWANIA"
    },
    {
     "type": "text",
     "text": "Lp. Część umundurowania Okres użytkowania"
    },
    {
     "type": "text",
     "text": "1 umundurowanie wyjściowe"
    },
    {
     "type": "text",
     "text": "a marynarka w kolorze oliwkowozielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "b spodnie lub spódnica w kolorze oliwkowozielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "c koszula z długimi rękawami w kolorze białym 18 miesięcy"
    },
    {
     "type": "text",
     "text": "d koszula z długimi rękawami w kolorze oliwkowozielonym 18 miesięcy"
    },
    {
     "type": "text",
     "text": "e krawat w kolorze zielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "f kurtka zimowa damska lub męska w kolorze ciemnozielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "g kapelusz damski lub męski w kolorze ciemnozielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "h czapka w kolorze zielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "2 umundurowanie polowe"
    },
    {
     "type": "text",
     "text": "a spodnie lub spódnica w kolorze oliwkowozielonym (2 sztuki) 18 miesięcy"
    },
    {
     "type": "text",
     "text": "b kurtka z odpinaną podpinką z polaru w kolorze ciemnozielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "c koszula z długimi rękawami w kolorze oliwkowozielonym 12 miesięcy"
    },
    {
     "type": "text",
     "text": "d koszula z krótkimi rękawami w kolorze oliwkowozielonym 24 miesiące"
    },
    {
     "type": "text",
     "text": "e krawat w kolorze zielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "f czapka letnia w kolorze zielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "g czapka zimowa w kolorze zielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "3 przedmioty uzupełniające mundury"
    },
    {
     "type": "text",
     "text": "a półbuty damskie lub męskie w kolorze brązowym do umundurowania wyjściowego 24 miesiące"
    },
    {
     "type": "text",
     "text": "b półbuty na grubej zelówce w kolorze brązowym 24 miesiące"
    },
    {
     "type": "text",
     "text": "c buty zimowe w kolorze brązowym 24 miesiące"
    },
    {
     "type": "text",
     "text": "d rękawice skórzane w kolorze brązowym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "e szalik w kolorze zielonym 36 miesięcy"
    },
    {
     "type": "text",
     "text": "f skarpety letnie w kolorze zielonym (3 pary) 12 miesięcy"
    },
    {
     "type": "text",
     "text": "g skarpety zimowe w kolorze zielonym (3 pary) 12 miesięcy"
    },
    {
     "type": "text",
     "text": "h rajstopy letnie w kolorze cielistym (3 pary) 12 miesięcy"
    },
    {
     "type": "text",
     "text": "i rajstopy zimowe w kolorze cielistym (3 pary) 12 miesięcy"
    }
   ]
  }
