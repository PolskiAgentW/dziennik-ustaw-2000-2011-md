{
 "eli": "DU/2005/754",
 "title": "Rozporządzenie Ministra Środowiska z dnia 28 kwietnia 2005 r. w sprawie wzoru legitymacji służbowej i wzorów umundurowania pracowników Służb Parków Narodowych oraz oznak służbowych dla poszczególnych stanowisk",
 "converter": "eli2md 0.6.18",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2005/754/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ŚRODOWISKA[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 28 kwietnia 2005 r."
  },
  {
   "type": "text",
   "text": "w sprawie wzoru legitymacji służbowej i wzorów umundurowania pracowników Służb Parków Narodowych oraz oznak służbowych dla poszczególnych stanowisk"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 104 ust. 19 ustawy z dnia 16 kwietnia 2004 r. o ochronie przyrody (Dz. U. Nr 92, poz. 880) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rozporządzenie określa dla pracowników Służb Parków Narodowych, zwanych dalej „pracownikami”:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "wzór legitymacji służbowej;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "wzory umundurowania wyjściowego i polowego na pory roku;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_1/pkt_3",
     "text": "kolor i wzór przedmiotów uzupełniających mundury;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_1/pkt_4",
     "text": "wzór orła umieszczanego na czapkach;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_1/pkt_5",
     "text": "wzory oznak służbowych dla poszczególnych stanowisk;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_1/pkt_6",
     "text": "okresy użytkowania części umundurowania.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_2/ust_1",
     "text": "Legitymacja służbowa dla pracowników o wymiarach 100 x 150 mm wykonana jest z papieru gwarantującego jej trwałość, w kolorze białym.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_2/ust_2",
     "text": "Wzór legitymacji służbowej dla pracowników określa załącznik nr 1 do rozporządzenia.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_3/ust_1",
     "text": "Umundurowanie dla pracowników składa się z:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_1/pkt_1",
       "text": "umundurowania wyjściowego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_1/pkt_2",
       "text": "umundurowania polowego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_1/pkt_3",
       "text": "przedmiotów uzupełniających mundury.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_3/ust_2",
     "text": "Częściami umundurowania wyjściowego są:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_2/pkt_1",
       "text": "marynarka w kolorze oliwkowozielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_2/pkt_2",
       "text": "spodnie lub spódnica w kolorze oliwkowozielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_2/pkt_3",
       "text": "koszula z długimi rękawami w kolorze białym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_3/ust_2/pkt_4",
       "text": "koszula z długimi rękawami w kolorze oliwkowozielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_3/ust_2/pkt_5",
       "text": "krawat w kolorze zielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_3/ust_2/pkt_6",
       "text": "kurtka zimowa damska lub męska w kolorze ciemnozielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "7",
       "path": "par_3/ust_2/pkt_7",
       "text": "kapelusz damski lub męski w kolorze ciemnozielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "8",
       "path": "par_3/ust_2/pkt_8",
       "text": "czapka w kolorze zielonym.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_3/ust_3",
     "text": "Wzór umundurowania wyjściowego określa załącznik nr 2 do rozporządzenia.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_3/ust_4",
     "text": "Częściami umundurowania polowego są:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_4/pkt_1",
       "text": "spodnie lub spódnica w kolorze oliwkowozielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_4/pkt_2",
       "text": "kurtka z odpinaną podpinką z polaru w kolorze ciemnozielonym;",
