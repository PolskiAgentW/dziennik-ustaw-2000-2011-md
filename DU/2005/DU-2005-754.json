       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_4/pkt_3",
       "text": "koszula z długimi rękawami w kolorze oliwkowozielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_3/ust_4/pkt_4",
       "text": "koszula z krótkimi rękawami w kolorze oliwkowozielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_3/ust_4/pkt_5",
       "text": "krawat w kolorze zielonym;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_3/ust_4/pkt_6",
       "text": "czapka letnia w kolorze zielonym;",
       "children": []
