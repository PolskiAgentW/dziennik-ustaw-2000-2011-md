         "num": "b",
         "path": "par_3/ust_8/pkt_1/lit_b",
         "text": "kurtek, o których mowa w ust. 2 pkt 6 i ust. 4 pkt 2, w odległości 8 cm poniżej wszycia rękawa,",
         "children": []
