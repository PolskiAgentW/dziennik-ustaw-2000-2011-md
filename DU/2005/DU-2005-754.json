    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_3/ust_5",
     "text": "Wzór umundurowania polowego określa załącznik nr 3 do rozporządzenia.",
     "children": []
    },
    {
     "type": "ust",
     "num": "6",
     "path": "par_3/ust_6",
     "text": "Przedmiotami uzupełniającymi mundury są:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_6/pkt_1",
       "text": "półbuty damskie lub męskie w kolorze brązowym do umundurowania wyjściowego;",
