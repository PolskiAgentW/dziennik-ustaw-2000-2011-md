{
 "eli": "DU/2005/327",
 "title": "Rozporządzenie Rady Ministrów z dnia 15 lutego 2005 r. w sprawie rodzajów roślin objętych płatnościami uzupełniającymi w 2005 r.",
 "converter": "eli2md 0.6.18",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2005/327/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 15 lutego 2005 r."
  },
  {
   "type": "text",
   "text": "w sprawie rodzajów roślin objętych płatnościami uzupełniającymi w 2005 r."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 2 ust. 5 pkt 1 ustawy z dnia 18 grudnia 2003 r. o płatnościach bezpośrednich do gruntów rolnych (Dz. U. z 2004 r. Nr 6, poz. 40, Nr 42, poz. 386 i Nr 148, poz. 1551) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Płatnościami uzupełniającymi są objęte następujące rodzaje roślin uprawiane w plonie głównym:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_1/pkt_1",
       "text": "zboża;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_1/pkt_2",
       "text": "rośliny oleiste — rzepak, rzepik, słonecznik i soja;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_1/pkt_3",
       "text": "rośliny wysokobiałkowe — bób, bobik, łubin słodki i groch siewny;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/ust_1/pkt_4",
       "text": "rośliny strączkowe — wyka siewna, soczewica jadalna i ciecierzyca pospolita;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_1/ust_1/pkt_5",
       "text": "orzechy — orzechy włoskie i leszczyna;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_1/ust_1/pkt_6",
       "text": "len włóknisty i oleisty;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "7",
       "path": "par_1/ust_1/pkt_7",
       "text": "konopie włókniste;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "8",
       "path": "par_1/ust_1/pkt_8",
       "text": "rośliny przeznaczone na materiał siewny kategorii elitarny i kwalifikowany, wymienione w załączniku do rozporządzenia;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "9",
       "path": "par_1/ust_1/pkt_9",
       "text": "rośliny przeznaczone na paszę, uprawiane na:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_1/ust_1/pkt_9/lit_a",
         "text": "łąkach i pastwiskach,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_1/ust_1/pkt_9/lit_b",
         "text": "gruntach ornych:",
         "children": [
          {
           "type": "text",
           "text": "— trawy,"
          },
          {
           "type": "text",
           "text": "— rośliny motylkowate drobnonasienne,"
          },
          {
           "type": "text",
           "text": "— rośliny strączkowe pastewne,"
          },
          {
           "type": "text",
           "text": "— rośliny okopowe pastewne, z wyłączeniem ziemniaków pastewnych."
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Rośliny wymienione w ust. 1 pkt 1—3 oraz pkt 9 lit. b tiret pierwsze—trzecie obejmuje się płatnościami uzupełniającymi również w przypadku ich uprawy w formie mieszanek.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc rozporządzenie Rady Ministrów z dnia 6 kwietnia 2004 r. w sprawie rodzajów roślin objętych płatnościami uzupełniającymi (Dz. U. Nr 65, poz. 596).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Belka"
  }
 ],
