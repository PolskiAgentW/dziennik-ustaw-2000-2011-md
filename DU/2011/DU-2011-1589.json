   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ROLNICTWA I ROZWOJU WSI[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 2 grudnia 2011 r."
  },
  {
   "type": "text",
   "text": "w sprawie maksymalnych sum ubezpieczenia dla poszczególnych upraw rolnych i zwierząt gospodarskich na 2012 r."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 5 ust. 2e ustawy z dnia 7 lipca 2005 r. o ubezpieczeniach upraw rolnych i zwierząt gospodarskich (Dz. U. Nr 150, poz. 1249, z późn. zm.[^2]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "W 2012 r. maksymalne sumy ubezpieczenia:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "1 ha upraw rolnych wynoszą:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_1/lit_a",
       "text": "8000 zł — dla zbóż,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_1/lit_b",
       "text": "10 000 zł — dla kukurydzy,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_1/lit_c",
       "text": "10 000 zł — dla rzepaku i rzepiku,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_1/pkt_1/lit_d",
       "text": "26 000 zł — dla chmielu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_1/pkt_1/lit_e",
       "text": "21 000 zł — dla tytoniu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_1/pkt_1/lit_f",
       "text": "129 000 zł — dla warzyw gruntowych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_1/pkt_1/lit_g",
       "text": "61 000 zł — dla drzew i krzewów owocowych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_1/pkt_1/lit_h",
       "text": "50 000 zł — dla truskawek,",
       "children": []
      },
      {
       "type": "lit",
       "num": "i",
       "path": "par_1/pkt_1/lit_i",
       "text": "30 000 zł — dla ziemniaków,",
       "children": []
