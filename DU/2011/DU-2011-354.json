       "num": "g",
       "path": "par_1/pkt_1/lit_g",
       "text": "pkt 16 i 17 otrzymują brzmienie:",
       "children": [
        {
         "type": "text",
         "text": "„16) Mazury;",
         "quoted": true
        },
        {
         "type": "text",
         "text": "17) Świdnik k. Lublina;”,",
         "quoted": true
        }
       ]
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_1/pkt_1/lit_h",
       "text": "pkt 19 otrzymuje brzmienie:",
       "children": [
        {
