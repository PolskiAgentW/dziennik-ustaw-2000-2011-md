{
 "eli": "DU/2002/766",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 20 czerwca 2002 r. w sprawie szczegółowego zakresu działania Ministra Środowiska.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2002/766/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 20 czerwca 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowego zakresu działania Ministra Środowiska."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 33 ust. 1 i 1a ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 1999 r. Nr 82, poz. 929, z 2000 r. Nr 120, poz. 1268 oraz z 2001 r. Nr 102, poz. 1116 i Nr 154, poz. 1799 i 1800) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Rozporządzenie określa szczegółowy zakres działania Ministra Środowiska, zwanego dalej „ministrem”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Minister kieruje następującymi działami administracji rządowej:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_2/pkt_1",
       "text": "gospodarka wodna,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_2/pkt_2",
       "text": "środowisko.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_1/ust_3",
     "text": "Minister jest dysponentem części 22 i 41 budżetu państwa.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_1/ust_4",
     "text": "Minister sprawuje nadzór nad:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_4/pkt_1",
       "text": "Głównym Inspektorem Ochrony Środowiska,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_4/pkt_2",
       "text": "Prezesem Państwowej Agencji Atomistyki.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_1/ust_5",
     "text": "Obsługę ministra zapewnia Ministerstwo Środowiska.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Minister wykonuje zadania związane z programem „Wisła – 2020”.",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem 1 lipca 2002 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
