{
 "eli": "DU/2002/487",
 "title": "Rozporządzenie Ministra Rolnictwa i Rozwoju Wsi z dnia 30 kwietnia 2002 r. w sprawie gatunków organizmów morskich, dla których ustanawia się okresy lub wymiary ochronne.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2002/487/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ROLNICTWA I ROZWOJU WSI"
  },
  {
   "type": "text",
   "text": "z dnia 30 kwietnia 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie gatunków organizmów morskich, dla których ustanawia się okresy lub wymiary ochronne."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 31 ust. 1 ustawy z dnia 6 września 2001 r. o rybołówstwie morskim (Dz. U. Nr 129, poz. 1441) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Ustanawia się wymiary ochronne dla następujących gatunków ryb:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_1/pkt_1",
       "text": "certy (Vimba vimba L.) —30 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_1/pkt_2",
       "text": "dorsza (Gadus morhua L.) — 35 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_1/pkt_3",
       "text": "gładzicy (Pleuronectes platessa L.) — 25 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/ust_1/pkt_4",
       "text": "leszcza (Abramis brama L.) — 40 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_1/ust_1/pkt_5",
       "text": "łososia (Salmo salar L.) — 60 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_1/ust_1/pkt_6",
       "text": "okonia (Perca fluviatilis L.) — 17 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "7",
       "path": "par_1/ust_1/pkt_7",
       "text": "płoci (Rutilus rutilus L.) — 20 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "8",
       "path": "par_1/ust_1/pkt_8",
       "text": "pstrąga tęczowego (Oncorhynchus mykiss Walb.) — 40 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "9",
       "path": "par_1/ust_1/pkt_9",
       "text": "sandacza (Stizostedion lucioperca L.) — 45 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "10",
       "path": "par_1/ust_1/pkt_10",
       "text": "siei (Coregonus lavertus L.) — 40 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "11",
       "path": "par_1/ust_1/pkt_11",
       "text": "skarpia (Psetta maxima L.) — 30 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "12",
       "path": "par_1/ust_1/pkt_12",
       "text": "nagłada (Scophthalmus rhombus L.) — 30 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "13",
       "path": "par_1/ust_1/pkt_13",
       "text": "storni (Platichthys flesus L.) — 25 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "14",
       "path": "par_1/ust_1/pkt_14",
       "text": "szczupaka (Esox lucius L.) — 45 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "15",
       "path": "par_1/ust_1/pkt_15",
       "text": "śledzia (Clupea harengus L.) — 16 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "16",
       "path": "par_1/ust_1/pkt_16",
       "text": "troci (Salmo trutta L.) — 50 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "17",
       "path": "par_1/ust_1/pkt_17",
       "text": "węgorza (Anguilla anguilla L.) — 40 cm,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "18",
       "path": "par_1/ust_1/pkt_18",
       "text": "zimnicy (Limanda limanda L.) —25 cm.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Wymiar ochronny, o którym mowa w ust. 1, ustala się, mierząc długość ryby, w stanie świeżym, od początku jej głowy do końca płetwy ogonowej.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Ustanawia się okresy ochronne dla następujących gatunków ryb:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "skarpia i nagłada — w terminie od dnia 1 czerwca do dnia 31 lipca,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "gładzicy i storni — w terminie od dnia 15 lutego do dnia 15 maja,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "dorsza — w terminie od dnia 1 czerwca do dnia 31 sierpnia,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "łososia i troci — w terminie od dnia:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_4/lit_a",
       "text": "1 czerwca do dnia 15 września poza 4-milowym pasem wód przybrzeżnych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_4/lit_b",
       "text": "15 września do dnia 15 listopada w 4-milowym pasie wód przybrzeżnych z wyłączeniem wód w granicach właściwości terytorialnej Okręgowego Inspektoratu Rybołówstwa Morskiego w Gdyni,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "sandacza — w terminie od dnia:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_5/lit_a",
       "text": "25 marca do dnia 10 maja na obszarze na zachód od południka 16° 40’ długości geograficznej wschodniej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_5/lit_b",
       "text": "10 kwietnia do dnia 31 maja na obszarze pomiędzy południkami 16° 40’ a 19° 00’ długości geograficznej wschodniej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_5/lit_c",
       "text": "20 kwietnia do dnia 10 czerwca na wschód od południka 19° 00’ długości geograficznej wschodniej.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Rolnictwa i Rozwoju Wsi: J. Kalinowski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
