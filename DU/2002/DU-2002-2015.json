      },
      {
       "type": "text",
       "text": "....................................................................................................................................................................................."
      }
     ]
    },
    {
     "type": "ust",
     "num": "6",
     "path": "par_6/ust_6",
     "text": "Wypadek spowodował niezdolność do pracy od ...................................... do ...................................................**",
     "children": [
      {
       "type": "text",
       "text": "Wypadek spowodował zgon ...................................................................................................................................."
      }
     ]
    },
    {
     "type": "ust",
     "num": "7",
     "path": "par_6/ust_7",
     "text": "Świadkowie wypadku:",
     "children": [
      {
       "type": "text",
       "text": "1..................................................................................................................................................................................."
      },
      {
       "type": "text",
       "text": "2..................................................................................................................................................................................."
      },
      {
       "type": "text",
       "text": "3.................................................................................................................................................................................."
      }
     ]
    },
    {
     "type": "ust",
     "num": "8",
     "path": "par_6/ust_8",
     "text": "Wypadek jest wypadkiem w drodze do pracy lub z pracy TAK/NIE*",
     "children": []
    },
    {
     "type": "ust",
     "num": "9",
     "path": "par_6/ust_9",
     "text": "Uzasadnienie nieuznania wypadku za wypadek w drodze do pracy lub z pracy*:",
     "children": [
      {
