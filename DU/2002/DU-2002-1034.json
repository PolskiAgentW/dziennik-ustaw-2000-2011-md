 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 16 lipca 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie autostrad płatnych."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 1 ust. 2 ustawy z dnia 27 października 1994 r. o autostradach płatnych (Dz. U. z 2001 r. Nr 110, poz. 1192 i z 2002 r. Nr 25, poz. 253) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Autostradami budowanymi i eksploatowanymi jako płatne będą:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "A1 Gdańsk—Toruń—Łódź—Piotrków Trybunalski—Częstochowa—Gliwice—Gorzyczki—granica państwa,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "A2 granica państwa — Świecko—Poznań—Łódź— Warszawa—Biała Podlaska—Kukuryki—granica państwa,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_1/pkt_3",
     "text": "A4 granica państwa—Jędrzychowice—Krzyżowa—Legnica—Wrocław—Opole—Gliwice— Katowice—Kraków—Tarnów—Rzeszów—Korczowa—granica państwa,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_1/pkt_4",
     "text": "A8 autostrada obwodnica Wrocławia na odcinku A4—Psie Pole,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_1/pkt_5",
     "text": "A18 granica państwa—Olszyna—Krzyżowa.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
