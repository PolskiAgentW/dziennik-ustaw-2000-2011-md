{
 "eli": "DU/2002/782",
 "title": "Rozporządzenie Ministra Rolnictwa i Rozwoju Wsi z dnia 21 czerwca 2002 r. w sprawie szczegółowej organizacji Inspekcji Ochrony Roślin i Nasiennictwa.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2002/782/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ROLNICTWA I ROZWOJU WSI"
  },
  {
   "type": "text",
   "text": "z dnia 21 czerwca 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowej organizacji Inspekcji Ochrony Roślin i Nasiennictwa."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 42 ust. 5 ustawy z dnia 12 lipca 1995 r. o ochronie roślin uprawnych (Dz. U. z 1999 r. Nr 66, poz. 751 i Nr 101, poz. 1178, z 2001 r. Nr 22, poz. 248 i Nr 76, poz. 811 oraz z 2002 r. Nr 25, poz. 253) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "W skład Inspekcji Ochrony Roślin i Nasiennictwa wchodzą:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_1/pkt_1",
       "text": "Główny Inspektorat Inspekcji Ochrony Roślin i Nasiennictwa, zwany dalej „Głównym Inspektoratem”,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_1/pkt_2",
       "text": "wojewódzkie inspektoraty Inspekcji Ochrony Roślin i Nasiennictwa, zwane dalej „wojewódzkimi inspektoratami”.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Organizację wewnętrzną Głównego Inspektoratu określa jego statut.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Wojewódzkim inspektoratem kieruje wojewódzki inspektor ochrony roślin i nasiennictwa przy pomocy zastępców wojewódzkiego inspektora oraz kierowników komórek organizacyjnych.",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_3/ust_1",
     "text": "W skład wojewódzkiego inspektoratu wchodzą:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_1/pkt_1",
       "text": "dział nadzoru fitosanitarnego,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_1/pkt_2",
       "text": "dział ochrony upraw,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_1/pkt_3",
       "text": "dział nadzoru nasiennego,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_3/ust_1/pkt_4",
       "text": "laboratorium wojewódzkie,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_3/ust_1/pkt_5",
       "text": "dział finansowy,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_3/ust_1/pkt_6",
       "text": "dział administracyjny,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "7",
       "path": "par_3/ust_1/pkt_7",
       "text": "stanowisko do spraw kadr,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "8",
       "path": "par_3/ust_1/pkt_8",
       "text": "stanowisko do spraw obsługi prawnej.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_3/ust_2",
     "text": "W skład wojewódzkiego inspektoratu może wchodzić stacja oceny nasion.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_4/ust_1",
     "text": "W przypadku utworzenia oddziału wojewódzkiego inspektoratu w jego skład wchodzą:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_4/ust_1/pkt_1",
       "text": "pracownia laboratoryjna,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_4/ust_1/pkt_2",
       "text": "stanowiska do realizacji zadań tego oddziału.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_4/ust_2",
     "text": "W przypadku utworzenia delegatury zamiejscowej w jej skład wchodzą:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_4/ust_2/pkt_1",
       "text": "laboratorium,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_4/ust_2/pkt_2",
       "text": "stanowiska do realizacji zadań tej delegatury.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "5",
   "path": "par_5",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Rolnictwa i Rozwoju Wsi: J. Kalinowski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
