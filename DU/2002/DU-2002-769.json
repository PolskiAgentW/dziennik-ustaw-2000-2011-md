{
 "eli": "DU/2002/769",
 "title": "Rozporządzenie Ministra Gospodarki z dnia 14 czerwca 2002 r. w sprawie wzorów wniosku o udzielenie wsparcia finansowego nowej inwestycji.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2002/769/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA GOSPODARKI"
  },
  {
   "type": "text",
   "text": "z dnia 14 czerwca 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie wzorów wniosku o udzielenie wsparcia finansowego nowej inwestycji."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 9 ust. 3 i art. 10 ust. 3 ustawy z dnia 20 marca 2002 r. o finansowym wspieraniu inwestycji (Dz. U. Nr 41, poz. 363) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Określa się:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "wzór wniosku o udzielenie gminie wsparcia finansowego nowej inwestycji na tworzenie i modernizację infrastruktury technicznej bezpośrednio związanej ze wspieraną inwestycją określonego przedsiębiorcy, stanowiący załącznik nr 1 do rozporządzenia,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "wzór wniosku o udzielenie przedsiębiorcy wsparcia finansowego nowej inwestycji, stanowiący załącznik nr 2 do rozporządzenia.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Gospodarki: J. Piechota"
  }
 ],
