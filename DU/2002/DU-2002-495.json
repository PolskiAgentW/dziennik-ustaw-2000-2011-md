{
 "eli": "DU/2002/495",
 "title": "Rozporządzenie Ministra Środowiska z dnia 15 kwietnia 2002 r. w sprawie szczegółowych zasad sporządzania projektu planu ochrony dla parku narodowego.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2002/495/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ŚRODOWISKA"
  },
  {
   "type": "text",
   "text": "z dnia 15 kwietnia 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowych zasad sporządzania projektu planu ochrony dla parku narodowego."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 13b ust. 4 pkt 1 ustawy z dnia 16 października 1991 r. o ochronie przyrody (Dz. U. z 2001 r. Nr 99, poz. 1079, Nr 100, poz. 1085, Nr 110, poz. 1189 i Nr 145, poz. 1623) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Projekt planu ochrony dla parku narodowego, zwany dalej „planem ochrony”, sporządza się z uwzględnieniem:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "wyników oceny wartości naukowych, przyrodniczych, społecznych, kulturowych i wychowawczych oraz swoistych cech krajobrazu,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "dostępnych opracowań w zakresie spraw, o których mowa w pkt 1, oraz map tematycznych obszaru objętego planem ochrony.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "W zależności od charakterystyki obszaru objętego planem ochrony ocena, o której mowa w § 1 pkt 1, obejmuje:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "charakterystykę przyrody nieożywionej i gleby w zakresie:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_1/lit_a",
       "text": "utworów geologicznych, wód podziemnych i rzeźby terenu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_1/lit_b",
       "text": "opisu gleby zgodnie z obowiązującą klasyfikacją gleb,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "charakterystykę ekosystemów wodnych z uwzględnieniem cech charakterystycznych przyrody i hydrografii,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "charakterystykę ekosystemów leśnych w zakresie:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_3/lit_a",
       "text": "typów siedliskowych lasu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_3/lit_b",
       "text": "zespołów roślinności leśnej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_3/lit_c",
       "text": "taksacji drzewostanów w wydzieleniach leśnych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_3/lit_d",
       "text": "zgodności składów gatunkowych drzewostanów z siedliskami,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_3/lit_e",
       "text": "opisu zdrowotności drzewostanów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_2/pkt_3/lit_f",
       "text": "struktury wiekowej i gatunkowej drzewostanów,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "charakterystykę lądowych ekosystemów nieleśnych w zakresie opisu rodzajów użytkowania gruntów,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "opis roślinności w zakresie zespołów roślinnych według aktualnego oraz potencjalnego ich stanu,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_2/pkt_6",
     "text": "opis gatunków roślin dziko występujących:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_6/lit_a",
       "text": "zagrożonych wyginięciem,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_6/lit_b",
       "text": "objętych ochroną krajową i międzynarodową,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_6/lit_c",
       "text": "ich siedlisk,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_6/lit_d",
       "text": "obcych zagrażających rodzimym gatunkom roślin,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_2/pkt_7",
     "text": "opis gatunków zwierząt dziko występujących:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_7/lit_a",
       "text": "zagrożonych wyginięciem,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_7/lit_b",
       "text": "objętych ochroną krajową i międzynarodową,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_7/lit_c",
       "text": "ich siedlisk,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_7/lit_d",
       "text": "obcych zagrażających rodzimym gatunkom zwierząt,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_2/pkt_8",
     "text": "opis wartości kulturowych, z wyszczególnieniem:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_8/lit_a",
       "text": "miejsc pamięci narodowej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_8/lit_b",
       "text": "obiektów zabytkowych o znaczeniu krajowym, regionalnym i lokalnym,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_2/pkt_9",
     "text": "charakterystykę stanu zagospodarowania przestrzennego, z opisem:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_9/lit_a",
       "text": "infrastruktury technicznej, turystycznej i edukacyjnej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_9/lit_b",
       "text": "zabudowy osadniczej i przemysłowej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_9/lit_c",
       "text": "terenów zieleni i zadrzewień,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_9/lit_d",
       "text": "terenów zdegradowanych pod względem przyrodniczym,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_9/lit_e",
       "text": "gruntów przeznaczonych do zalesienia,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_2/pkt_9/lit_f",
       "text": "zagrożeń wewnętrznych i zewnętrznych dla środowiska przyrodniczego, w szczególności pochodzenia antropogenicznego,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_2/pkt_10",
     "text": "sporządzenie map tematycznych, w zakresie:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_2/pkt_10/lit_a",
       "text": "występowania wód powierzchniowych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_2/pkt_10/lit_b",
       "text": "klasyfikacji gleb,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_2/pkt_10/lit_c",
       "text": "występowania ekosystemów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_2/pkt_10/lit_d",
       "text": "typów siedliskowych lasu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_2/pkt_10/lit_e",
       "text": "aktualnej roślinności,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_2/pkt_10/lit_f",
       "text": "potencjalnej roślinności,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_2/pkt_10/lit_g",
       "text": "miejsc występowania zagrożeń wewnętrznych i zewnętrznych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_2/pkt_10/lit_h",
       "text": "występowania siedlisk przyrodniczych, siedlisk gatunków roślin dziko występujących i siedlisk gatunków zwierząt dziko występujących, podlegających ochronie,",
       "children": []
      },
      {
       "type": "lit",
       "num": "i",
       "path": "par_2/pkt_10/lit_i",
       "text": "rozmieszczenia chronionych gatunków roślin i zwierząt,",
       "children": []
      },
      {
       "type": "lit",
       "num": "j",
       "path": "par_2/pkt_10/lit_j",
       "text": "infrastruktury technicznej, turystycznej i edukacyjnej.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Plan ochrony zawiera opis:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_3/pkt_1",
     "text": "sposobów użytkowania gleb,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_3/pkt_2",
     "text": "zagadnień gospodarki wodno-ściekowej, regulacji stosunków wodnych i użytkowania ekosystemów wodnych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_3/pkt_3",
     "text": "sposobów ochrony ekosystemów leśnych w zakresie:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_3/pkt_3/lit_a",
       "text": "nasiennictwa i szkółkarstwa,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_3/pkt_3/lit_b",
       "text": "zalesiania i odnawiania lasu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_3/pkt_3/lit_c",
       "text": "pielęgnacji i hodowli drzewostanów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_3/pkt_3/lit_d",
       "text": "ochrony drzewostanów przed szkodliwym działaniem czynników biotycznych i abiotycznych,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_3/pkt_4",
     "text": "sposobów ochrony lądowych ekosystemów nieleśnych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_3/pkt_5",
     "text": "sposobów ochrony gatunków zwierząt dziko występujących oraz ich siedlisk, z wyszczególnieniem sposobów ochrony, restytucji oraz regulacji liczebności populacji gatunków,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_3/pkt_6",
     "text": "sposobów ochrony gatunków roślin dziko występujących oraz ich siedlisk, z wyszczególnieniem sposobów ochrony oraz restytucji,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_3/pkt_7",
     "text": "utrzymania albo przywracania utraconych wartości kulturowych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_3/pkt_8",
     "text": "ochrony walorów krajobrazowych, w szczególności widokowych i przyrodniczo-krajobrazowych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_3/pkt_9",
     "text": "miejsc lokalizacji obiektów infrastruktury turystycznej i edukacyjnej,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_3/pkt_10",
     "text": "ustaleń do miejscowych planów zagospodarowania przestrzennego w zakresie:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_3/pkt_10/lit_a",
       "text": "gospodarki wodno-ściekowej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_3/pkt_10/lit_b",
       "text": "kształtowania bilansu wodnego na obszarze parku narodowego,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_3/pkt_10/lit_c",
       "text": "propozycji eliminacji lub ograniczenia źródeł zagrożeń dla środowiska,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_3/pkt_10/lit_d",
       "text": "propozycji wskazań odpowiedniego działania dla prowadzenia racjonalnej gospodarki rolnej, leśnej i rybackiej na obszarach niebędących w zarządzie parku narodowego,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_3/pkt_10/lit_e",
       "text": "propozycji wskazań terenów zdegradowanych do rekultywacji i odtwarzania ekosystemów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_3/pkt_10/lit_f",
       "text": "propozycji zagospodarowania terenów zieleni i zadrzewień,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_3/pkt_10/lit_g",
       "text": "propozycji wskazań gruntów do zalesień,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_3/pkt_10/lit_h",
       "text": "propozycji wskazań miejsc lokalizacji obiektów infrastruktury turystycznej i edukacyjnej.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Plan ochrony składa się z:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_4/pkt_1",
     "text": "opisów wyszczególnionych w § 3,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_4/pkt_2",
     "text": "opisu zawierającego:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_4/pkt_2/lit_a",
       "text": "wskazanie podstawy prawnej działania i nazwy parku narodowego,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_4/pkt_2/lit_b",
       "text": "dane dotyczące powierzchni, położenia, granic, stanu środowiska, infrastruktury technicznej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_4/pkt_2/lit_c",
       "text": "dane dotyczące form własności gruntów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_4/pkt_2/lit_d",
       "text": "zadania ochronne oraz sposoby ich wykonywania,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_4/pkt_2/lit_e",
       "text": "charakterystykę gleb, ekosystemów, siedlisk przyrodniczych, gatunków roślin dziko występujących i gatunków zwierząt dziko występujących oraz ich siedlisk, a także krajobrazów i wartości kulturowych,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_4/pkt_3",
     "text": "mapy parku narodowego uwzględniającej występujące ekosystemy, sieć dróg, nazwy miejscowości,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_4/pkt_4",
     "text": "mapy parku narodowego przedstawiającej obszary ochrony ścisłej, częściowej i krajobrazowej.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "5",
   "path": "par_5",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Środowiska: S. Żelichowski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
