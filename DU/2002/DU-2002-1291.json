 "title": "Rozporządzenie Ministra Infrastruktury z dnia 17 września 2002 r. w sprawie określenia wzoru karty drogowej.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2002/1291/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA INFRASTRUKTURY"
  },
  {
   "type": "text",
   "text": "z dnia 17 września 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie określenia wzoru karty drogowej."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 36 ust. 3 ustawy z dnia 24 sierpnia 2001 r. o czasie pracy kierowców (Dz. U. Nr 123, poz. 1354 i z 2002 r. Nr 155, poz. 1286) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Określa się wzór karty drogowej, stanowiący załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie z dniem 1 października 2002 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Infrastruktury: M. Pol"
  }
 ],
