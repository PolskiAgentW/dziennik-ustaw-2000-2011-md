    },
    {
     "type": "ust",
     "num": "1",
     "path": "ust_1",
     "text": "Niniejszy nakaz odnosi się ogółem do: ...................................... przestępstw.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "ust_2",
     "text": "Okoliczności popełnienia przestępstwa (przestępstw): ............................................................................................................................................................................",
     "children": [
