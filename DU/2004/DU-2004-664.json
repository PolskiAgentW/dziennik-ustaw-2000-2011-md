 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA SPRAWIEDLIWOŚCI"
  },
  {
   "type": "text",
   "text": "z dnia 20 kwietnia 2004 r."
  },
  {
   "type": "text",
   "text": "w sprawie wzoru europejskiego nakazu aresztowania"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 607c § 3 ustawy z dnia 6 czerwca 1997 r. — Kodeks postępowania karnego (Dz. U. Nr 89, poz. 555, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Określa się wzór europejskiego nakazu aresztowania, który stanowi załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie z dniem 1 maja 2004 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Sprawiedliwości: G. Kurczuk"
  }
 ],
 "annexes": [
