{
 "eli": "DU/2004/1120",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 4 maja 2004 r. w sprawie zakresu działania Ministra Gospodarki i Pracy",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2004/1120/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 4 maja 2004 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowego zakresu działania Ministra Gospodarki i Pracy"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 33 ust. 1 i 1a ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199 i Nr 80, poz. 717) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Rozporządzenie określa szczegółowy zakres działania Ministra Gospodarki i Pracy, zwanego dalej „ministrem”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Minister kieruje następującymi działami administracji rządowej:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_2/pkt_1",
       "text": "gospodarka;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_2/pkt_2",
       "text": "praca;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_2/pkt_3",
       "text": "rozwój regionalny;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/ust_2/pkt_4",
       "text": "turystyka.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_1/ust_3",
     "text": "Minister jest dysponentem części 20, 31, 34 i 40 budżetu państwa.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_1/ust_4",
     "text": "Obsługę ministra do dnia 3 maja 2004 r. zapewnia Ministerstwo Gospodarki, Pracy i Polityki Społecznej, a od dnia 4 maja 2004 r. — Ministerstwo Gospodarki i Pracy.",
     "children": []
    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_1/ust_5",
     "text": "Organami podległymi ministrowi lub przez niego nadzorowanymi są:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_5/pkt_1",
       "text": "Prezes Głównego Urzędu Miar;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_5/pkt_2",
       "text": "Prezes Urzędu Regulacji Energetyki;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_5/pkt_3",
       "text": "Urząd Patentowy Rzeczypospolitej Polskiej.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia, z mocą od dnia 2 maja 2004 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Belka"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
