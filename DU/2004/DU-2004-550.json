     "text": "EWIDENCJA WYNIKÓW DZIAŁAŃ STRAŻY GMINNEJ (MIEJSKIEJ)"
    },
    {
     "type": "text",
     "text": "Mandat Wniosek Lp. Rodzaje wykroczeń zawartych w: Pouczenie do sądu Razem liczba kwota"
    },
    {
     "type": "text",
     "text": "1 Kodeks wykroczeń"
    },
    {
     "type": "lit",
     "num": "a",
     "path": "lit_a",
     "text": "wykroczenia przeciwko porządkowi i spokojowi publicznemu",
     "children": []
    },
    {
     "type": "text",
     "text": "wykroczenia przeciwko instytub) cjom państwowym, samorządowym i społecznym"
    },
    {
     "type": "lit",
     "num": "c",
     "path": "lit_c",
     "text": "wykroczenia przeciwko bezpieczeństwu osób i mienia",
     "children": []
    },
    {
     "type": "text",
     "text": "wykroczenia przeciwko bezpied) czeństwu i porządkowi w komunikacji"
    },
    {
     "type": "lit",
     "num": "e",
     "path": "lit_e",
     "text": "wykroczenia przeciwko osobie",
     "children": []
    },
    {
     "type": "lit",
     "num": "f",
