{
 "eli": "DU/2004/1391",
 "title": "Rozporządzenie Ministra Rolnictwa i Rozwoju Wsi z dnia 13 maja 2004 r. w sprawie wykazu substancji aktywnych, których stosowanie w środkach ochrony roślin jest zabronione",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2004/1391/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ROLNICTWA I ROZWOJU WSI[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 13 maja 2004 r."
  },
  {
   "type": "text",
   "text": "w sprawie wykazu substancji aktywnych, których stosowanie w środkach ochrony roślin jest zabronione"
  },
  {
   "type": "text",
   "text": "Na postawie art. 37 ust. 7 ustawy z dnia 18 grudnia 2003 r. o ochronie roślin (Dz. U. z 2004 r. Nr 11, poz. 94) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rozporządzenie określa:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "wykaz substancji aktywnych, których stosowanie w środkach ochrony roślin jest zabronione lub podlega ograniczeniom, który jest określony w załączniku nr 1 do rozporządzenia;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "wykaz substancji aktywnych, dla których Komisja Europejska wydała decyzję w sprawie niedopuszczenia ich do stosowania w środkach ochrony roślin, oraz termin, w jakim środki ochrony roślin zawierające te substancje mogą znajdować się w obrocie, który jest określony w załączniku nr 2 do rozporządzenia.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 7 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Rolnictwa i Rozwoju Wsi: W. Olejniczak"
  }
 ],
 "annexes": [
