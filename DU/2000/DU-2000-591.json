{
 "eli": "DU/2000/591",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 20 czerwca 2000 r. w sprawie szczegółowego zakresu działania Ministra Transportu i Gospodarki Morskiej.",
 "converter": "eli2md 0.6.16",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2000/591/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 20 czerwca 2000 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowego zakresu działania Ministra Transportu i Gospodarki Morskiej."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 33 ust. 1 i 1a ustawy z dnia 8 sierpnia 1996 r. o organizacji i trybie pracy Rady Ministrów oraz o zakresie działania ministrów (Dz. U. z 1999 r. Nr 82, poz. 929) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Rozporządzenie określa szczegółowy zakres działania Ministra Transportu i Gospodarki Morskiej, zwanego dalej „ministrem”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Minister kieruje następującymi działami administracji rządowej:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_2/pkt_1",
       "text": "gospodarka morska,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_2/pkt_2",
       "text": "transport.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_1/ust_3",
     "text": "Minister jest dysponentem części 21 i 39 budżetu państwa.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_1/ust_4",
     "text": "Obsługę ministra zapewnia Ministerstwo Transportu i Gospodarki Morskiej.",
     "children": []
    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_1/ust_5",
     "text": "Organy i jednostki organizacyjne podległe ministrowi lub przez niego nadzorowane, z zastrzeżeniem art. 34 ust. 2 ustawy z dnia 8 sierpnia 1996 r. o organizacji i trybie pracy Rady Ministrów oraz o zakresie działania ministrów (Dz. U. z 1999 r. Nr 82, poz. 929), określa załącznik do rozporządzenia.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc rozporządzenie Prezesa Rady Ministrów z dnia 30 listopada 1999 r. w sprawie szczegółowego zakresu działania Ministra Transportu i Gospodarki Morskiej (Dz. U. Nr 96, poz. 1124 i z 2000 r. Nr 8, poz. 105).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Buzek"
  }
 ],
