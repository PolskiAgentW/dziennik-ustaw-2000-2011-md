   "path": "par_2",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_2/ust_1",
     "text": "W zakresie transakcji dotyczących usług o charakterze administracyjnym oraz innych świadczeń o charakterze niematerialnym szkodliwa konkurencja podatkowa jest stosowana:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_2/ust_1/pkt_1",
       "text": "w systemach podatkowych w następujących krajach:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_2/ust_1/pkt_1/lit_a",
         "text": "Królestwie Belgii,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_2/ust_1/pkt_1/lit_b",
