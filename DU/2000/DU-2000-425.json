{
 "eli": "DU/2000/425",
 "title": "Rozporządzenie Ministra Edukacji Narodowej z dnia 18 kwietnia 2000 r. w sprawie przekształceń w Państwowej Wyższej Szkole Zawodowej w Elblągu.",
 "converter": "eli2md 0.6.16",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2000/425/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA EDUKACJI NARODOWEJ"
  },
  {
   "type": "text",
   "text": "z dnia 18 kwietnia 2000 r."
  },
  {
   "type": "text",
   "text": "w sprawie przekształceń w Państwowej Wyższej Szkole Zawodowej w Elblągu."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 10 ust. 4 ustawy z dnia 26 czerwca 1997 r. o wyższych szkołach zawodowych (Dz.U. Nr 96, poz. 590 i z 1998 r. Nr 106, poz. 668) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "W Państwowej Wyższej Szkole Zawodowej w Elblągu, utworzonej na podstawie rozporządzenia Rady Ministrów z dnia 16 czerwca 1998 r. w sprawie utworzenia Państwowej Wyższej Szkoły Zawodowej w Elblągu (Dz. U. Nr 76, poz. 495 i z 1999 r. Nr 50, poz. 506), dokonuje się zmiany specjalności kształcenia polegającej na:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "wprowadzeniu następujących specjalności zawodowych:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_1/lit_a",
       "text": "zarządzanie małym i średnim przedsiębiorstwem,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_1/lit_b",
       "text": "finanse przedsiębiorstw,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_1/lit_c",
       "text": "elektrotechnika z informatyką techniczną,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_1/pkt_1/lit_d",
       "text": "inżynieria mechaniczna,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_1/pkt_1/lit_e",
       "text": "edukacja wczesnoszkolna z językiem obcym;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "zniesieniu z dniem 30 września 2000 r. następujących specjalności zawodowych:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_2/lit_a",
       "text": "technologia budowy maszyn,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_2/lit_b",
       "text": "systemy, maszyny i urządzenia energetyczne.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie po upływie 7 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Edukacji Narodowej: M. Handke"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
