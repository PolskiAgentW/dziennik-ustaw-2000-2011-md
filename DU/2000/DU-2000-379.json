      },
      {
       "type": "text",
       "text": "1012 Poradnia alergii pokarmowych"
      },
      {
       "type": "text",
       "text": "1014 Poradnia alergii oddechowych"
      },
      {
       "type": "text",
       "text": "1016 Poradnia alergii skórnych"
      },
      {
       "type": "text",
       "text": "1020 Poradnia diabetologiczna"
      },
      {
       "type": "text",
       "text": "1030 Poradnia endokrynologiczna"
      },
      {
       "type": "text",
       "text": "1032 Poradnia endokrynologiczno-ginekologiczna"
      },
      {
       "type": "text",
       "text": "1034 Poradnia andrologiczna"
      },
      {
       "type": "text",
       "text": "1036 Poradnia leczenia niepłodności"
      },
      {
       "type": "text",
       "text": "1038 Poradnia schorzeń tarczycy"
      },
      {
       "type": "text",
