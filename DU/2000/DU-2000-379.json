      },
      {
       "type": "text",
       "text": "1120 Poradnia chorób naczyń"
      },
      {
       "type": "text",
       "text": "1130 Poradnia nefrologiczna"
      },
      {
       "type": "text",
       "text": "1140 Poradnia medycyny nuklearnej"
      },
      {
       "type": "text",
       "text": "1150 Poradnia toksykologiczna"
      },
      {
       "type": "text",
       "text": "1160 Poradnia medycyny pracy"
      },
      {
       "type": "text",
       "text": "1180 Poradnia medycyny paliatywnej"
      },
      {
       "type": "text",
       "text": "Komórki organizacyjne innych specjalizacji zachowawczych"
      },
      {
       "type": "text",
