{
 "eli": "DU/2000/706",
 "title": "Rozporządzenie Rady Ministrów z dnia 18 lipca 2000 r. w sprawie utworzenia Państwowej Wyższej Szkoły Zawodowej w Pile.",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2000/706/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 18 lipca 2000 r."
  },
  {
   "type": "text",
   "text": "w sprawie utworzenia Państwowej Wyższej Szkoły Zawodowej w Pile."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 10 ust. 1 ustawy z dnia 26 czerwca 1997 r. o wyższych szkołach zawodowych (Dz. U. Nr 96, poz. 590 i z 1998 r. Nr 106, poz. 668) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Tworzy się z dniem 1 sierpnia 2000 r. państwową wyższą szkołę zawodową pod nazwą „Państwowa Wyższa Szkoła Zawodowa w Pile”, zwaną dalej „Uczelnią”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Siedzibą Uczelni jest miasto Piła.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Uczelnia prowadzi następujące specjalności zawodowe:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "edukacja społeczno-obywatelska,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "język angielski,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "budowa i eksploatacja maszyn,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "gospodarka i finanse samorządowe,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "elektrotechnika z elektroniką.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 7 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Buzek"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
