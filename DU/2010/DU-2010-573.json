      },
      {
       "type": "text",
       "text": "tytuł prawny: ………………………………..................................................................…………………………………... (własność, współwłasność — wielkość udziału; użytkowanie wieczyste; dzierżawa; inny tytuł — podać jaki)"
      }
     ]
    },
    {
     "type": "ust",
     "num": "5",
     "path": "ust_5",
     "text": "Zasoby pieniężne:",
     "children": [
      {
       "type": "text",
       "text": "— środki pieniężne zgromadzone w walucie polskiej: ............................................................................................"
      },
      {
       "type": "text",
       "text": ".................................................................................................................................................................................."
      },
      {
       "type": "text",
       "text": "— środki pieniężne zgromadzone w walutach obcych: ..........................................................................................."
      },
      {
       "type": "text",
       "text": ".................................................................................................................................................................................."
      },
      {
       "type": "text",
       "text": "— papiery wartościowe: ............................................................................................................................................."
