{
 "eli": "DU/2010/199",
 "title": "Rozporządzenie Ministra Finansów z dnia 2 marca 2010 r. w sprawie uposażenia zasadniczego funkcjonariuszy celnych",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2010/199/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA FINANSÓW[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 2 marca 2010 r."
  },
  {
   "type": "text",
   "text": "w sprawie uposażenia zasadniczego funkcjonariuszy celnych"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 147 ustawy z dnia 27 sierpnia 2009 r. o Służbie Celnej (Dz. U. Nr 168, poz. 1323 i Nr 201, poz. 1540) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rozporządzenie określa:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "grupy uposażenia zasadniczego funkcjonariuszy celnych;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "zaszeregowanie stanowisk służbowych funkcjonariuszy celnych do poszczególnych grup uposażenia zasadniczego oraz odpowiadające im wysokości tego uposażenia ustalone z zastosowaniem mnożników kwoty bazowej.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_2/ust_1",
     "text": "Ustala się grupy uposażenia zasadniczego oraz odpowiadające im wysokości mnożników kwoty bazowej, określone w tabelach stanowiących załącznik nr 1 do rozporządzenia.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_2/ust_2",
     "text": "Wysokość kwoty bazowej, o której mowa w ust. 1, określa ustawa budżetowa.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_2/ust_3",
     "text": "Wysokość uposażenia zasadniczego dla poszczególnych grup uposażenia stanowi iloczyn mnożnika, o którym mowa w ust. 1, i kwoty bazowej, o której mowa w ust. 2.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_2/ust_4",
     "text": "Wysokość uposażenia zasadniczego zaokrągla się do pełnych dziesięciu groszy w górę.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zaszeregowanie stanowisk służbowych funkcjonariuszy celnych do poszczególnych grup uposażenia zasadniczego określają tabele stanowiące załącznik nr 2 do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.[^2]",
   "children": [
    {
     "type": "text",
     "text": "Minister Finansów: w z. E. Suchocka-Roguska"
    }
   ]
  }
 ],
