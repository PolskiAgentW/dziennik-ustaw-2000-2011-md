{
 "eli": "DU/2007/1423",
 "title": "Rozporządzenie Ministra Zdrowia z dnia 24 września 2007 r. w sprawie wykazu przejść granicznych właściwych dla przeprowadzania granicznej kontroli sanitarnej",
 "converter": "eli2md 0.6.18",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2007/1423/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ZDROWIA[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 24 września 2007 r."
  },
  {
   "type": "text",
   "text": "w sprawie wykazu przejść granicznych właściwych dla przeprowadzania granicznej kontroli sanitarnej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 83 ust. 2 pkt 1 ustawy z dnia 25 sierpnia 2006 r. o bezpieczeństwie żywności i żywienia (Dz. U. Nr 171, poz. 1225) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ustala się wykaz przejść granicznych, przez które środki spożywcze oraz materiały lub wyroby przeznaczone do kontaktu z żywnością, podlegające granicznej kontroli sanitarnej, mogą być wprowadzane na terytorium Wspólnoty Europejskiej stanowiący załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc rozporządzenie Ministra Zdrowia z dnia 30 kwietnia 2004 r. w sprawie wykazu przejść granicznych właściwych dla przewozu żywności oraz materiałów i wyrobów przeznaczonych do kontaktu z żywnością (Dz. U. Nr 104, poz. 1105).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": [
    {
     "type": "text",
     "text": "Minister Zdrowia: w z. B. Piecha"
    },
    {
     "type": "text",
     "text": "Załącznik do rozporządzenia Ministra Zdrowia z dnia 24 września 2007 r. (poz. 1423)"
    },
    {
     "type": "text",
     "text": "WYKAZ PRZEJŚĆ GRANICZNYCH, PRZEZ KTÓRE ŚRODKI SPOŻYWCZE ORAZ MATERIAŁY LUB WYROBY PRZEZNACZONE DO KONTAKTU Z ŻYWNOŚCIĄ, PODLEGAJĄCE GRANICZNEJ KONTROLI SANITARNEJ, MOGĄ BYĆ WPROWADZANE NA TERYTORIUM WSPÓLNOTY EUROPEJSKIEJ"
    },
    {
     "type": "ust",
     "num": "1",
     "path": "par_3/ust_1",
     "text": "Północno-wschodni i wschodni odcinek granicy państwowej:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_1/pkt_1",
       "text": "z Federacją Rosyjską:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_3/ust_1/pkt_1/lit_a",
         "text": "Bezledy (drogowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_3/ust_1/pkt_1/lit_b",
         "text": "Braniewo (kolejowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_3/ust_1/pkt_1/lit_c",
         "text": "Gołdap (drogowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_3/ust_1/pkt_1/lit_d",
         "text": "Gronowo (drogowe);",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_1/pkt_2",
       "text": "z Republiką Białorusi:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_3/ust_1/pkt_2/lit_a",
         "text": "Bobrowniki (drogowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_3/ust_1/pkt_2/lit_b",
         "text": "Kukuryki (drogowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_3/ust_1/pkt_2/lit_c",
         "text": "Kuźnica (drogowe, kolejowe)",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_3/ust_1/pkt_2/lit_d",
         "text": "Terespol (drogowe, kolejowe);",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_1/pkt_3",
       "text": "z Ukrainą:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_3/ust_1/pkt_3/lit_a",
         "text": "Dorohusk (drogowe, kolejowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_3/ust_1/pkt_3/lit_b",
         "text": "Hrebenne (drogowe, kolejowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_3/ust_1/pkt_3/lit_c",
         "text": "Hrubieszów (kolejowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_3/ust_1/pkt_3/lit_d",
         "text": "Korczowa (drogowe, kolejowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "e",
         "path": "par_3/ust_1/pkt_3/lit_e",
         "text": "Medyka (drogowe, kolejowe),",
         "children": []
        },
        {
         "type": "lit",
         "num": "f",
         "path": "par_3/ust_1/pkt_3/lit_f",
         "text": "Przemyśl (kolejowe).",
         "children": []
        }
       ]
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_3/ust_2",
     "text": "Północny (morski) odcinek granicy państwowej — porty morskie:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_2/pkt_1",
       "text": "Gdańsk;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_2/pkt_2",
       "text": "Gdynia;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_2/pkt_3",
       "text": "Kołobrzeg;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_3/ust_2/pkt_4",
       "text": "Szczecin;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_3/ust_2/pkt_5",
       "text": "Świnoujście.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_3/ust_3",
     "text": "Przejścia graniczne lotnicze — porty lotnicze:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_3/pkt_1",
       "text": "Gdańsk-Rębiechowo;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_3/pkt_2",
       "text": "Poznań-Ławica;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_3/pkt_3",
       "text": "Katowice-Pyrzowice;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_3/ust_3/pkt_4",
       "text": "Rzeszów-Jasionka;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_3/ust_3/pkt_5",
       "text": "Warszawa-Okęcie;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_3/ust_3/pkt_6",
       "text": "Kraków-Balice;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "7",
       "path": "par_3/ust_3/pkt_7",
       "text": "Szczecin-Goleniów;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "8",
       "path": "par_3/ust_3/pkt_8",
       "text": "Wrocław-Strachowice.",
       "children": []
      }
     ]
    }
   ]
  }
 ],
