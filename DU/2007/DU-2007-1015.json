      },
      {
       "type": "text",
       "text": "III"
      }
     ]
    },
    {
     "type": "ust",
     "num": "1",
     "path": "ust_1",
     "text": "a * Nie jestem członkiem zarządu ani rady nadzorczej, komisji rewizyjnej spółki prawa handlowego.",
     "children": [
      {
       "type": "text",
       "text": "b * Jestem członkiem zarządu, rady nadzorczej lub komisji rewizyjnej spółki prawa handlowego:"
      },
      {
       "type": "text",
       "text": "........................................................................................................................................................................................... (wymienić pełnione funkcje i stanowiska wraz z nazwami spółek i fundacji)"
      },
      {
       "type": "text",
       "text": "..........................................................................................................................................................................................."
      },
