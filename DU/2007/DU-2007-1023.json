       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_3/ust_2",
     "text": "W skład komórek organizacyjnych, o których mowa w ust. 1, wchodzą wydziały, sekcje oraz samodzielne stanowiska pracy.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_4/ust_1",
     "text": "W skład oddziałów regionalnych wchodzą:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_4/ust_1/pkt_1",
       "text": "biura, w których mogą być wydzielone wydziały, sekcje lub samodzielne stanowiska pracy;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_4/ust_1/pkt_2",
       "text": "wydziały;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_4/ust_1/pkt_3",
       "text": "sekcje;",
