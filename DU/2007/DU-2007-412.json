{
 "eli": "DU/2007/412",
 "title": "Rozporządzenie Rady Ministrów z dnia 20 marca 2007 r. w sprawie wykazu linii kolejowych o znaczeniu państwowym",
 "converter": "eli2md 0.6.18",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2007/412/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 20 marca 2007 r."
  },
  {
   "type": "text",
   "text": "w sprawie wykazu linii kolejowych o znaczeniu państwowym"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 6 ust. 2 ustawy z dnia 28 marca 2003 r. o transporcie kolejowym (Dz. U. z 2007 r. Nr 16, poz. 94) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rozporządzenie określa wykaz linii kolejowych, które ze względów gospodarczych, społecznych, obronnych lub ekologicznych mają znaczenie państwowe.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Wykaz linii kolejowych, o których mowa w § 1, określa załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Traci moc rozporządzenie Rady Ministrów z dnia 7 grudnia 2004 r. w sprawie wykazu linii kolejowych o znaczeniu państwowym (Dz. U. Nr 273, poz. 2704).",
   "children": []
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Kaczyński"
  }
 ],
