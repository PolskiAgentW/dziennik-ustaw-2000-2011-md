  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Upoważnia się Dyrektora Urzędu Morskiego w Gdyni do uznawania kwalifikacji w następujących zawodach regulowanych związanych z wykonywaniem prac podwodnych:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "nurek III klasy;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "nurek II klasy;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "nurek I klasy;",
