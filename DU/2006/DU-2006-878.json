     "text": "obszar dorzecza Dniestru — region wodny Dniestru;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_4/pkt_4",
     "text": "obszar dorzecza Dunaju:",
     "children": [
      {
