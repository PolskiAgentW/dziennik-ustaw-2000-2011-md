      {
       "type": "lit",
       "num": "c",
       "path": "pkt_3/lit_c",
       "text": "pensjonatowych — ...................... ha.",
       "children": [
        {
         "type": "text",
         "text": "§ 5"
        },
        {
         "type": "text",
         "text": "Na terenie uzdrowiska znajdują się udokumentowane następujące naturalne surowce lecznicze:"
