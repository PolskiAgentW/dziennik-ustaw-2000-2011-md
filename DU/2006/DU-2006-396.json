    {
     "type": "pkt",
     "num": "1",
     "path": "pkt_1",
     "text": "wykaz zakładów lecznictwa uzdrowiskowego z określeniem funkcjonowania w nich zakładów przyrodoleczniczych i urządzeń lecznictwa uzdrowiskowego;",
