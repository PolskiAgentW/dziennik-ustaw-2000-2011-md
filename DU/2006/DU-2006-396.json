    {
     "type": "pkt",
     "num": "2",
     "path": "pkt_2",
     "text": "wykaz pomników przyrody na obszarze uzdrowiska.",
     "children": [
      {
       "type": "text",
       "text": "§ 8 Załącznikami graficznymi do statutu są:"
