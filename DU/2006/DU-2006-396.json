    },
    {
     "type": "pkt",
     "num": "1",
     "path": "pkt_1",
     "text": "mapa strefy „A” z naniesieniem istniejących i projektowanych zakładów lecznictwa uzdrowiskowego i urządzeń lecznictwa uzdrowiskowego i oznaczonymi ulicami w skali nie mniejszej niż 1:10 000;",
     "children": []
